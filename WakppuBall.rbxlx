<roblox version="4">
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	게임 밸런스 설정 (서버와 클라이언트가 함께 씁니다)
	숫자를 바꾸고 다시 플레이(F5)하면 바로 적용됩니다.
]]

local Config = {}

Config.GameName = "왁뿌볼 던지기"
Config.BallName = "왁뿌볼"

-- 게임패스 --------------------------------------------------------------------
-- 크리에이터 대시보드에서 게임패스를 만든 뒤 id에 번호를 넣으세요. 0이면 "준비 중"으로 표시됩니다.
-- StudioOwnsAllPasses = true로 바꾸면 스튜디오 테스트에서만 모든 게임패스를 가진 것으로 취급합니다.
Config.StudioOwnsAllPasses = false

Config.GamePasses = {
	DoubleSpeed = { id = 0, name = "2배 속도", icon = "⚡", robux = 99, desc = "던질 때 얻는 속도 2배" },
	AutoThrow = { id = 0, name = "자동 던지기", icon = "🤖", robux = 249, desc = "버튼 하나로 계속 던지기" },
	DoubleTrophies = { id = 0, name = "2배 트로피", icon = "🏆", robux = 95, desc = "귀환할 때 받는 트로피 2배" },
	DeathInsurance = { id = 0, name = "사망 보험", icon = "🛡️", robux = 149, desc = "죽어도 미수령 트로피 30% 보존" },
	GoldDummy = { id = 0, name = "황금 허수아비", icon = "🥇", robux = 79, desc = "허수아비 훈련 x3" },
	DiamondDummy = { id = 0, name = "다이아 허수아비", icon = "💎", robux = 345, desc = "허수아비 훈련 x9" },
	CandyDummy = { id = 0, name = "캔디 허수아비", icon = "🍭", robux = 749, desc = "허수아비 훈련 x25" },
	AdminDummy = { id = 0, name = "운영자 허수아비", icon = "👑", robux = 1199, desc = "허수아비 훈련 x100" },
	GalaxyBall = { id = 0, name = "은하 왁뿌볼", icon = "🌌", robux = 295, desc = "속도 x10 스킨" },
	ChocoBall = { id = 0, name = "초코 왁뿌볼", icon = "🍫", robux = 499, desc = "속도 x20 스킨" },
	AdminBall = { id = 0, name = "운영자 왁뿌볼", icon = "👑", robux = 1799, desc = "속도 x100 스킨" },
}

-- 상점에 보여줄 게임패스 순서
Config.PassOrder = {
	"DoubleSpeed",
	"AutoThrow",
	"DoubleTrophies",
	"DeathInsurance",
	"GoldDummy",
	"DiamondDummy",
	"CandyDummy",
	"AdminDummy",
}

Config.FreeAutoThrow = true -- false면 자동 던지기는 게임패스가 있어야 씁니다
Config.DeathInsuranceKeep = 0.3

-- 던지기 -----------------------------------------------------------------------

Config.ThrowRange = 55
Config.MaxThrowsPerSecond = 10

function Config.ThrowsPerSecond(speed)
	return math.min(Config.MaxThrowsPerSecond, 3 + 1.2 * math.log(1 + speed / 100, 2))
end

function Config.Damage(speed)
	return 1 + math.floor(speed / 20)
end

-- 던지기 파워 발판 (로비의 숫자 발판). 밟으면 트로피로 구매, 던질 때 얻는 기본 속도가 됩니다.
Config.Pads = {
	{ value = 1, cost = 0 },
	{ value = 2, cost = 3 },
	{ value = 3, cost = 15 },
	{ value = 5, cost = 60 },
	{ value = 10, cost = 250 },
	{ value = 25, cost = 1000 },
	{ value = 50, cost = 4000 },
	{ value = 100, cost = 15000 },
	{ value = 250, cost = 60000 },
	{ value = 500, cost = 200000 },
}

-- 왁뿌볼 스킨 (원작의 트레일). 하나만 장착, 속도 배수
Config.Skins = {
	{ id = "basic", name = "기본 왁뿌볼", rarity = 1, mult = 1, cost = 0, color = Color3.fromRGB(255, 130, 190) },
	{ id = "green", name = "초록 왁뿌볼", rarity = 1, mult = 1.5, cost = 100, color = Color3.fromRGB(90, 220, 110) },
	{ id = "sky", name = "하늘 왁뿌볼", rarity = 1, mult = 2, cost = 400, color = Color3.fromRGB(90, 180, 255) },
	{ id = "purple", name = "보라 왁뿌볼", rarity = 2, mult = 3, cost = 1500, color = Color3.fromRGB(170, 90, 255) },
	{ id = "fire", name = "불꽃 왁뿌볼", rarity = 2, mult = 4, cost = 6000, color = Color3.fromRGB(255, 90, 50) },
	{ id = "rainbow", name = "무지개 왁뿌볼", rarity = 3, mult = 5, cost = 25000, color = Color3.fromRGB(255, 255, 255), rainbow = true },
	{ id = "gold", name = "황금 왁뿌볼", rarity = 3, mult = 8, cost = 150000, color = Color3.fromRGB(255, 205, 60) },
	{ id = "galaxy", name = "은하 왁뿌볼", rarity = 4, mult = 10, pass = "GalaxyBall", color = Color3.fromRGB(60, 40, 140) },
	{ id = "choco", name = "초코 왁뿌볼", rarity = 4, mult = 20, pass = "ChocoBall", color = Color3.fromRGB(120, 70, 40) },
	{ id = "admin", name = "운영자 왁뿌볼", rarity = 5, mult = 100, pass = "AdminBall", color = Color3.fromRGB(255, 40, 40), rainbow = true },
	-- 월드 보스를 처음 잡으면 받는 전용 스킨
	{ id = "crown1", name = "초원 왕관볼", rarity = 4, mult = 6, boss = 1, color = Color3.fromRGB(150, 255, 120) },
	{ id = "crown2", name = "사탕 왕관볼", rarity = 4, mult = 15, boss = 2, color = Color3.fromRGB(255, 150, 220) },
	{ id = "crown3", name = "별빛 왕관볼", rarity = 5, mult = 40, boss = 3, color = Color3.fromRGB(140, 220, 255) },
}

-- 오라. 스킨 배수 위에 곱해집니다
Config.Auras = {
	{ id = "sparkle", name = "반짝 오라", rarity = 2, mult = 1.2, cost = 20000, color = Color3.fromRGB(255, 255, 200) },
	{ id = "water", name = "물결 오라", rarity = 3, mult = 2, cost = 150000, color = Color3.fromRGB(80, 170, 255) },
	{ id = "flame", name = "화염 오라", rarity = 4, mult = 3, cost = 800000, color = Color3.fromRGB(255, 110, 40) },
	{ id = "thunder", name = "번개 오라", rarity = 5, mult = 5, cost = 5000000, color = Color3.fromRGB(255, 240, 80) },
}

Config.Rarities = {
	{ name = "일반", color = Color3.fromRGB(180, 180, 190) },
	{ name = "희귀", color = Color3.fromRGB(80, 170, 255) },
	{ name = "영웅", color = Color3.fromRGB(190, 90, 255) },
	{ name = "전설", color = Color3.fromRGB(255, 180, 40) },
	{ name = "신화", color = Color3.fromRGB(255, 70, 90) },
}

-- 훈련 허수아비 (원작의 트레드밀). 노란 원 안에 서 있으면 자동으로 던집니다
Config.Dummies = {
	{ name = "나무 허수아비", mult = 1, color = Color3.fromRGB(200, 160, 110) },
	{ name = "황금 허수아비", mult = 3, pass = "GoldDummy", color = Color3.fromRGB(255, 205, 60) },
	{ name = "다이아 허수아비", mult = 9, pass = "DiamondDummy", color = Color3.fromRGB(120, 230, 255) },
	{ name = "캔디 허수아비", mult = 25, pass = "CandyDummy", color = Color3.fromRGB(255, 140, 210) },
	{ name = "운영자 허수아비", mult = 100, pass = "AdminDummy", color = Color3.fromRGB(255, 70, 70) },
}
Config.DummyRange = 8
Config.DummyThrowsPerSecond = 2

function Config.FindById(list, id)
	for _, item in ipairs(list) do
		if item.id == id then
			return item
		end
	end
	return nil
end

-- 던질 때 얻는 속도 = 발판 파워 × 환생 × 스킨 × 오라 × 2배 패스 × 운영자 이벤트
-- ctx = { pad, rebirths, skin, aura, doubleSpeed, eventMult }
function Config.SpeedMultiplier(ctx)
	local skin = Config.FindById(Config.Skins, ctx.skin)
	local aura = Config.FindById(Config.Auras, ctx.aura)
	return Config.RebirthMultiplier(ctx.rebirths)
		* (skin and skin.mult or 1)
		* (aura and aura.mult or 1)
		* (ctx.doubleSpeed and 2 or 1)
		* (ctx.eventMult or 1)
end

function Config.GainPerThrow(ctx)
	local pad = Config.Pads[ctx.pad] or Config.Pads[1]
	return pad.value * Config.SpeedMultiplier(ctx)
end

-- 레벨 ------------------------------------------------------------------------

function Config.SpeedForLevel(level)
	if level <= 1 then
		return 0
	end
	return math.floor(10 * (level - 1) ^ 2.5)
end

function Config.LevelFromSpeed(speed)
	if speed <= 0 then
		return 1
	end
	local level = math.max(1, math.floor((speed / 10) ^ (1 / 2.5)) + 1)
	while level > 1 and Config.SpeedForLevel(level) > speed do
		level -= 1
	end
	while Config.SpeedForLevel(level + 1) <= speed do
		level += 1
	end
	return level
end

function Config.MaxHealth(level)
	return 100 + (level - 1) * 10
end

function Config.WalkSpeed(level)
	return math.min(32, 16 + level * 0.1)
end

-- 환생 ------------------------------------------------------------------------
-- n번째 환생에 필요한 레벨과, n번 환생했을 때의 속도 배수

local REBIRTH_LEVELS = { 15, 25, 40, 55, 75, 100, 130, 160, 200, 250, 300, 380, 460, 540, 600 }
local REBIRTH_MULTS = { 1.5, 2, 2.5, 3, 3.5, 5, 6.5, 8, 10, 15, 25, 50, 100, 250, 500 }

function Config.RebirthLevel(rebirths)
	local nextRebirth = rebirths + 1
	if REBIRTH_LEVELS[nextRebirth] then
		return REBIRTH_LEVELS[nextRebirth]
	end
	return REBIRTH_LEVELS[#REBIRTH_LEVELS] + (nextRebirth - #REBIRTH_LEVELS) * 80
end

function Config.RebirthMultiplier(rebirths)
	if rebirths <= 0 then
		return 1
	end
	if REBIRTH_MULTS[rebirths] then
		return REBIRTH_MULTS[rebirths]
	end
	return REBIRTH_MULTS[#REBIRTH_MULTS] * 2 ^ (rebirths - #REBIRTH_MULTS)
end

-- 월드와 스테이지 ---------------------------------------------------------------

Config.StagesPerWorld = 13
Config.TargetStageSeconds = 15 -- 권장 레벨이면 한 스테이지 적을 이 시간 안에 처치

Config.Worlds = {
	{
		name = "말랑 초원",
		level = 1,
		recommended = { 1, 100 }, -- 1스테이지, 마지막 스테이지 권장 레벨
		rewardMult = 1,
		keyColors = { Color3.fromRGB(245, 245, 250), Color3.fromRGB(205, 235, 200) },
		dangerColor = Color3.fromRGB(255, 160, 140),
		enemyNames = { "말랑이", "재빠름이", "단단이" },
		bossName = "왕말랑이",
		bossColor = Color3.fromRGB(90, 200, 90),
	},
	{
		name = "사탕 왕국",
		level = 120,
		recommended = { 120, 380 },
		rewardMult = 500,
		keyColors = { Color3.fromRGB(255, 225, 240), Color3.fromRGB(200, 150, 110) },
		dangerColor = Color3.fromRGB(255, 90, 160),
		enemyNames = { "젤리곰", "솜사탕", "초코벽돌" },
		bossName = "거대 곰젤리",
		bossColor = Color3.fromRGB(255, 120, 190),
	},
	{
		name = "별빛 우주",
		level = 400,
		recommended = { 400, 840 },
		rewardMult = 250000,
		keyColors = { Color3.fromRGB(60, 60, 90), Color3.fromRGB(110, 90, 170) },
		dangerColor = Color3.fromRGB(150, 90, 255),
		enemyNames = { "별똥이", "유성", "블랙홀" },
		bossName = "은하 대왕",
		bossColor = Color3.fromRGB(120, 90, 255),
	},
}

function Config.RecommendedLevel(world, stage)
	local range = Config.Worlds[world].recommended
	local t = (stage - 1) / math.max(1, Config.StagesPerWorld - 1)
	return math.max(1, math.floor(range[1] * (range[2] / range[1]) ^ t + 0.5))
end

function Config.StageReward(world, stage)
	return math.ceil(3 * 1.9 ^ (stage - 1) * Config.Worlds[world].rewardMult)
end

-- 이 스테이지로 바로 텔레포트하는 비용 (트로피)
function Config.TeleportCost(world, stage)
	if stage <= 1 then
		return 0
	end
	return math.ceil(Config.StageReward(world, stage - 1) * 1.5)
end

function Config.EnemyCount(_world, stage)
	return 3 + math.floor((stage - 1) * 0.6)
end

-- 적 체력은 "권장 레벨의 공격력으로 TargetStageSeconds 안에 전멸"이 되도록 계산합니다
function Config.EnemyHealth(world, stage)
	local speed = Config.SpeedForLevel(Config.RecommendedLevel(world, stage))
	local dps = Config.Damage(speed) * Config.ThrowsPerSecond(speed)
	local total = dps * Config.TargetStageSeconds
	return math.max(3, math.floor(total / (Config.EnemyCount(world, stage) * 1.3)))
end

function Config.EnemyDamage(world, stage)
	return math.ceil(Config.MaxHealth(Config.RecommendedLevel(world, stage)) * 0.12)
end

function Config.PathLength(stage)
	return math.min(320, 140 + stage * 12)
end

function Config.PathWidth(stage)
	return math.max(12, 32 - stage * 1.6)
end

-- 깊은 스테이지일수록 키보드 사이 구멍(점프 구간)이 늘어납니다
function Config.GapCount(stage)
	return math.floor(stage / 3)
end

Config.EnemyAggroRange = 70
Config.EnemyAttackCooldown = 1

-- 적 종류 (이름은 월드마다 다름: Config.Worlds[n].enemyNames)
Config.EnemyTypes = {
	{ id = "Slime", minStage = 1, weight = 5, health = 1, speed = 7, damage = 1, size = 4, shape = "Ball", color = Color3.fromRGB(120, 220, 120) },
	{ id = "Runner", minStage = 3, weight = 3, health = 0.6, speed = 15, damage = 0.7, size = 3, shape = "Ball", color = Color3.fromRGB(255, 210, 70) },
	{ id = "Brute", minStage = 5, weight = 2, health = 3, speed = 4.5, damage = 2, size = 7, shape = "Block", color = Color3.fromRGB(230, 90, 90) },
}

Config.Boss = { health = 12, damage = 2, speed = 5, size = 13 }

-- 무료 보상 ---------------------------------------------------------------------

Config.GiftCooldown = 4 * 60 * 60 -- 무료 선물 상자 (4시간마다)
Config.GiftThrows = 400 -- 선물 = 지금 던지기 400번 분량의 속도

-- 코드 (대문자로 적으세요)
Config.Codes = {
	WAKPPU = { speed = 1000, text = "속도 +1,000" },
	RELEASE = { trophies = 50, text = "트로피 +50" },
}

-- 운영자 이벤트: 채팅에 /event 10 30 (속도 10배, 30분) · /event off
Config.Admins = {} -- 운영자 UserId 목록 (게임 주인과 스튜디오는 자동으로 운영자)

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- 큰 숫자를 1.23K, 4.5M 처럼 짧게 보여줍니다

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Short(n)
	n = n or 0
	if n < 0 then
		return "-" .. Format.Short(-n)
	end
	if n < 1000 then
		return tostring(math.floor(n))
	end
	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n /= 1000
		index += 1
	end
	local text = string.format("%.2f", n):gsub("0+$", ""):gsub("%.$", "")
	return text .. SUFFIXES[index]
end

return Format
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[--[[
	저장 (DataStore)
	스튜디오에서 저장까지 테스트하려면: 게임을 Roblox에 게시한 뒤
	홈 → 게임 설정 → 보안 → "Studio에서 API 서비스 사용"을 켜세요.
	꺼져 있어도 게임은 그대로 돌아가고, 저장만 건너뜁니다.
]]

local DataStoreService = game:GetService("DataStoreService")

local Data = {}

-- 저장되는 값과 기본값 (미수령 트로피는 저장하지 않습니다)
local DEFAULTS = {
	Speed = 0,
	Trophies = 0,
	Pad = 1, -- 구매한 가장 높은 던지기 파워 발판 번호
	Rebirths = 0,
	BestStages = { 0, 0, 0 }, -- 월드별 최고 클리어 스테이지
	Skins = { basic = true },
	Skin = "basic",
	Auras = {},
	Aura = "",
	Codes = {},
	LastGift = 0,
}

local STORE_NAME = "WakppuBall_v2"

local store, topStore
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(STORE_NAME)
		topStore = DataStoreService:GetOrderedDataStore("TopSpeed_v2")
	end)
	if not ok then
		store, topStore = nil, nil
		warn("[저장] DataStore를 쓸 수 없어서 이번 세션은 저장하지 않아요: " .. tostring(err))
	end
end

Data.TopStore = topStore

local canSave = {}

local function keyFor(player)
	return "player_" .. player.UserId
end

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[k] = deepCopy(v)
	end
	return copy
end

function Data.Defaults()
	return deepCopy(DEFAULTS)
end

function Data.Load(player)
	local data = deepCopy(DEFAULTS)
	if not store then
		return data
	end

	local ok, saved
	for attempt = 1, 3 do
		ok, saved = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok then
			break
		end
		if attempt < 3 then
			task.wait(1)
		end
	end

	if not ok then
		warn("[저장] " .. player.Name .. " 데이터를 불러오지 못해서 이번 세션은 저장하지 않아요: " .. tostring(saved))
		return data
	end

	if type(saved) == "table" then
		for key, default in pairs(DEFAULTS) do
			if type(saved[key]) == type(default) then
				data[key] = saved[key]
			end
		end
		-- 월드가 늘어나도 칸이 모자라지 않게
		for i = 1, #DEFAULTS.BestStages do
			data.BestStages[i] = tonumber(data.BestStages[i]) or 0
		end
		data.Skins.basic = true
	end
	canSave[player] = true
	return data
end

function Data.Save(player, data)
	if not store or not canSave[player] then
		return
	end
	local payload = {}
	for key in pairs(DEFAULTS) do
		payload[key] = data[key]
	end
	local ok, err = pcall(function()
		store:SetAsync(keyFor(player), payload)
	end)
	if not ok then
		warn("[저장] " .. player.Name .. " 저장 실패: " .. tostring(err))
	end
	if topStore then
		pcall(function()
			topStore:SetAsync(tostring(player.UserId), math.floor(math.min(data.Speed, 2 ^ 52)))
		end)
	end
end

function Data.Release(player)
	canSave[player] = nil
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	왁뿌볼 던지기 — 서버
	던지기 → 속도 → 적 처치 → 안전지대에서 귀환(노란 발판) / 전진(초록 포털) → 죽으면 미수령 트로피 상실
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local World = require(script.Parent:WaitForChild("World"))
local Data = require(script.Parent:WaitForChild("Data"))
local Passes = require(script.Parent:WaitForChild("Passes"))

Players.RespawnTime = 3
Lighting.ClockTime = 14

-- 서버 ↔ 클라이언트 통신 ----------------------------------------------------------

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local function newRemote(name)
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotes
	return remote
end

local ThrowRemote = newRemote("Throw") -- 클라 → 서버: 던지기
local ActionRemote = newRemote("Action") -- 클라 → 서버: 상점, 환생, 텔레포트, 코드, 선물
local ThrowFx = newRemote("ThrowFx") -- 서버 → 모두: 볼 날아가는 연출
local Notify = newRemote("Notify") -- 서버 → 클라: 알림
remotes.Parent = ReplicatedStorage

workspace:SetAttribute("EventMult", 1)
workspace:SetAttribute("EventEnds", 0)

local lobby = World.BuildLobby()

local states = {} -- [player] = { data, lastThrow, run, cooldowns }
local slots = {} -- 스테이지를 지을 자리 [번호] = player

-- 상태 동기화 -----------------------------------------------------------------------

local function updateLeaderstats(player, state)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	leaderstats["⚡ 속도"].Value = Format.Short(state.data.Speed)
	leaderstats["🏆 트로피"].Value = Format.Short(state.data.Trophies)
	leaderstats["🔁 환생"].Value = state.data.Rebirths
end

-- 숫자/문자 값: 상태와 플레이어 속성을 함께 바꿉니다
local function set(player, state, key, value)
	state.data[key] = value
	player:SetAttribute(key, value)
	if key == "Speed" or key == "Trophies" or key == "Rebirths" then
		updateLeaderstats(player, state)
	end
end

-- 표(목록) 값: JSON 글자로 바꿔서 속성에 넣습니다 (예: SkinsJson)
local function syncTable(player, state, key)
	player:SetAttribute(key .. "Json", HttpService:JSONEncode(state.data[key]))
end

local function syncPasses(player)
	player:SetAttribute("PassesJson", HttpService:JSONEncode(Passes.Get(player)))
end

local function eventMultiplier()
	if workspace:GetAttribute("EventEnds") > os.time() then
		return workspace:GetAttribute("EventMult")
	end
	return 1
end

local function speedContext(player, state)
	local data = state.data
	return {
		pad = data.Pad,
		rebirths = data.Rebirths,
		skin = data.Skin,
		aura = data.Aura,
		doubleSpeed = Passes.Owns(player, "DoubleSpeed"),
		eventMult = eventMultiplier(),
	}
end

local function getCharacterParts(player)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return root, humanoid
end

local function toast(player, text, color)
	Notify:FireClient(player, "toast", { text = text, color = color })
end

-- 같은 일이 너무 자주 일어나지 않게 (발판 위에 서 있을 때 알림이 쏟아지는 것 방지)
local function ready(state, key, seconds)
	local now = os.clock()
	if (state.cooldowns[key] or 0) > now then
		return false
	end
	state.cooldowns[key] = now + seconds
	return true
end

local RED = Color3.fromRGB(255, 120, 120)
local GOLD = Color3.fromRGB(255, 214, 90)
local CYAN = Color3.fromRGB(120, 230, 255)

local function applyLevelStats(player, state)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local ratio = humanoid.Health / humanoid.MaxHealth
	humanoid.MaxHealth = Config.MaxHealth(state.data.Level)
	humanoid.Health = humanoid.MaxHealth * ratio
	humanoid.WalkSpeed = Config.WalkSpeed(state.data.Level)
end

local function addSpeed(player, state, amount)
	set(player, state, "Speed", state.data.Speed + amount)
	local newLevel = Config.LevelFromSpeed(state.data.Speed)
	if newLevel ~= state.data.Level then
		local leveledUp = newLevel > state.data.Level
		set(player, state, "Level", newLevel)
		applyLevelStats(player, state)
		if leveledUp then
			Notify:FireClient(player, "levelUp", { level = newLevel })
		end
	end
end

-- 오라: 캐릭터 주변에 반짝이는 입자
local function applyAura(player, state)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local old = root:FindFirstChild("AuraFx")
	if old then
		old:Destroy()
	end
	local aura = Config.FindById(Config.Auras, state.data.Aura)
	if not aura then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "AuraFx"
	emitter.Color = ColorSequence.new(aura.color)
	emitter.LightEmission = 1
	emitter.Rate = 25
	emitter.Lifetime = NumberRange.new(0.8, 1.4)
	emitter.Speed = NumberRange.new(1.5, 3)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new(0.2)
	emitter.Parent = root
end

-- 스테이지 진행 -----------------------------------------------------------------------

local function teleport(player, cframe)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(cframe)
	end
end

local function clearRun(player, state)
	local run = state.run
	if not run then
		return
	end
	state.run = nil
	if run.map then
		run.map.folder:Destroy()
	end
	slots[run.slot] = nil
	-- Stage를 먼저 0으로: 화면은 Stage > 0일 때만 World를 읽습니다
	set(player, state, "Stage", 0)
	set(player, state, "World", 0)
	set(player, state, "EnemiesLeft", 0)
end

local function bankAndReturn(player, state)
	local amount = state.data.Unbanked
	if Passes.Owns(player, "DoubleTrophies") then
		amount *= 2
	end
	set(player, state, "Trophies", state.data.Trophies + amount)
	set(player, state, "Unbanked", 0)
	clearRun(player, state)
	teleport(player, lobby.spawnCFrame)
	Notify:FireClient(player, "banked", { amount = amount })
end

local buildStage

local function onSafeZoneTouched(player, run, stage, hit, goNext)
	local state = states[player]
	local character = player.Character
	if not state or state.run ~= run or not run.map or run.map.stage ~= stage then
		return
	end
	if not character or not hit:IsDescendantOf(character) or not run.exitOpen or run.leaving then
		return
	end
	run.leaving = true
	if goNext then
		buildStage(player, state, run.map.world, stage + 1)
	else
		bankAndReturn(player, state)
	end
end

function buildStage(player, state, world, stage)
	local run = state.run
	if run.map then
		run.map.folder:Destroy()
	end
	local map = World.BuildStage(run.origin, world, stage, player.Name)
	run.map = map
	run.alive = #map.enemies
	run.exitOpen = false
	run.leaving = false

	map.bankPad.Touched:Connect(function(hit)
		onSafeZoneTouched(player, run, stage, hit, false)
	end)
	if map.nextPortal then
		map.nextPortal.Touched:Connect(function(hit)
			onSafeZoneTouched(player, run, stage, hit, true)
		end)
	end

	set(player, state, "World", world)
	set(player, state, "Stage", stage)
	set(player, state, "EnemiesLeft", run.alive)
	teleport(player, map.startCFrame)
	Notify:FireClient(player, "stageStart", {
		world = world,
		stage = stage,
		recommended = Config.RecommendedLevel(world, stage),
	})
end

local function startRun(player, state, world, stage)
	if state.run then
		return
	end
	if not getCharacterParts(player) then
		return
	end
	local slot = 1
	while slots[slot] do
		slot += 1
	end
	slots[slot] = player
	state.run = { slot = slot, origin = Vector3.new(slot * 1000, 300, 0) }
	set(player, state, "Unbanked", 0)
	buildStage(player, state, world, stage)
end

local function onStageCleared(player, state)
	local run = state.run
	local world, stage = run.map.world, run.map.stage
	run.exitOpen = true

	local reward = Config.StageReward(world, stage)
	set(player, state, "Unbanked", state.data.Unbanked + reward)
	if stage > state.data.BestStages[world] then
		state.data.BestStages[world] = stage
		syncTable(player, state, "BestStages")
	end

	local isLast = stage >= Config.StagesPerWorld
	Notify:FireClient(player, "cleared", {
		world = world,
		stage = stage,
		reward = reward,
		unbanked = state.data.Unbanked,
		isLast = isLast,
		nextRecommended = not isLast and Config.RecommendedLevel(world, stage + 1) or nil,
	})

	-- 월드 보스를 처음 잡으면 전용 스킨
	if isLast then
		for _, skin in ipairs(Config.Skins) do
			if skin.boss == world and not state.data.Skins[skin.id] then
				state.data.Skins[skin.id] = true
				syncTable(player, state, "Skins")
				Notify:FireClient(player, "newSkin", { id = skin.id, name = skin.name, mult = skin.mult })
			end
		end
	end
end

local function onDied(player)
	local state = states[player]
	if not state or not state.run then
		return
	end
	local lost = state.data.Unbanked
	local kept = 0
	if Passes.Owns(player, "DeathInsurance") then
		kept = math.floor(lost * Config.DeathInsuranceKeep)
		set(player, state, "Trophies", state.data.Trophies + kept)
	end
	local stage = state.run.map and state.run.map.stage or 0
	set(player, state, "Unbanked", 0)
	clearRun(player, state)
	Notify:FireClient(player, "death", { lost = lost - kept, kept = kept, stage = stage })
end

-- 던지기 --------------------------------------------------------------------------

local function findTarget(run, position)
	if not run or not run.map then
		return nil
	end
	local best, bestDistance = nil, Config.ThrowRange
	for _, enemy in ipairs(run.map.enemies) do
		if not enemy.dead then
			local distance = (enemy.part.Position - position).Magnitude
			if distance <= bestDistance then
				best, bestDistance = enemy, distance
			end
		end
	end
	return best
end

local function damageEnemy(player, state, enemy, damage)
	local run = state.run
	enemy.health -= damage
	World.UpdateEnemyBar(enemy)
	if enemy.health > 0 or enemy.dead then
		return
	end
	enemy.dead = true
	World.KillEnemy(enemy)
	run.alive -= 1
	set(player, state, "EnemiesLeft", run.alive)
	World.UpdateGate(run.map, run.alive)
	if run.alive <= 0 then
		onStageCleared(player, state)
	end
end

ThrowRemote.OnServerEvent:Connect(function(player)
	local state = states[player]
	if not state then
		return
	end
	local root = getCharacterParts(player)
	if not root then
		return
	end

	-- 공속보다 빠른 요청은 무시 (오토클릭 방지)
	local now = os.clock()
	local interval = 1 / Config.ThrowsPerSecond(state.data.Speed)
	if now - state.lastThrow < interval * 0.85 then
		return
	end
	state.lastThrow = now

	local gain = Config.GainPerThrow(speedContext(player, state))
	addSpeed(player, state, gain)

	local from = root.Position + Vector3.new(0, 1.5, 0)
	local target = findTarget(state.run, root.Position)
	if target then
		local damage = Config.Damage(state.data.Speed)
		ThrowFx:FireAllClients(player, from, target.part.Position, damage, gain, state.data.Skin)
		damageEnemy(player, state, target, damage)
	else
		local landing = from + root.CFrame.LookVector * 30 - Vector3.new(0, 3, 0)
		ThrowFx:FireAllClients(player, from, landing, nil, gain, state.data.Skin)
	end
end)

-- 상점·환생·텔레포트·코드·선물 ---------------------------------------------------------------

local function ownsSkin(player, state, skin)
	return skin.id == "basic" or state.data.Skins[skin.id] == true or Passes.Owns(player, skin.pass)
end

local function equipBest(player, state)
	local bestSkin, bestAura = Config.Skins[1], nil
	for _, skin in ipairs(Config.Skins) do
		if ownsSkin(player, state, skin) and skin.mult > bestSkin.mult then
			bestSkin = skin
		end
	end
	for _, aura in ipairs(Config.Auras) do
		if state.data.Auras[aura.id] and (not bestAura or aura.mult > bestAura.mult) then
			bestAura = aura
		end
	end
	set(player, state, "Skin", bestSkin.id)
	set(player, state, "Aura", bestAura and bestAura.id or "")
	applyAura(player, state)
end

local actions = {}

function actions.buySkin(player, state, id)
	local skin = Config.FindById(Config.Skins, id)
	if not skin or ownsSkin(player, state, skin) then
		return
	end
	if skin.pass then
		local ok, reason = Passes.Prompt(player, skin.pass)
		if not ok then
			toast(player, reason, RED)
		end
		return
	end
	if skin.boss then
		toast(player, "월드 " .. skin.boss .. " 보스를 쓰러뜨리면 얻을 수 있어요", RED)
		return
	end
	if state.data.Trophies < skin.cost then
		toast(player, "🏆 트로피가 부족해요", RED)
		return
	end
	set(player, state, "Trophies", state.data.Trophies - skin.cost)
	state.data.Skins[skin.id] = true
	syncTable(player, state, "Skins")
	set(player, state, "Skin", skin.id)
	Notify:FireClient(player, "newSkin", { id = skin.id, name = skin.name, mult = skin.mult })
end

function actions.equipSkin(player, state, id)
	local skin = Config.FindById(Config.Skins, id)
	if skin and ownsSkin(player, state, skin) then
		set(player, state, "Skin", skin.id)
	end
end

function actions.buyAura(player, state, id)
	local aura = Config.FindById(Config.Auras, id)
	if not aura or state.data.Auras[aura.id] then
		return
	end
	if state.data.Trophies < aura.cost then
		toast(player, "🏆 트로피가 부족해요", RED)
		return
	end
	set(player, state, "Trophies", state.data.Trophies - aura.cost)
	state.data.Auras[aura.id] = true
	syncTable(player, state, "Auras")
	set(player, state, "Aura", aura.id)
	applyAura(player, state)
	toast(player, "✨ " .. aura.name .. " 획득! 속도 x" .. aura.mult, GOLD)
end

function actions.equipAura(player, state, id)
	if id == "" or (Config.FindById(Config.Auras, id) and state.data.Auras[id]) then
		set(player, state, "Aura", id)
		applyAura(player, state)
	end
end

function actions.equipBest(player, state)
	equipBest(player, state)
	toast(player, "✅ 가장 좋은 걸로 장착했어요", CYAN)
end

function actions.buyPass(player, _state, key)
	local ok, reason = Passes.Prompt(player, key)
	if not ok then
		toast(player, reason, RED)
	end
end

function actions.rebirth(player, state)
	if state.run then
		toast(player, "환생은 로비에서만 할 수 있어요", RED)
		return
	end
	local need = Config.RebirthLevel(state.data.Rebirths)
	if state.data.Level < need then
		toast(player, "레벨 " .. need .. "이 필요해요", RED)
		return
	end
	set(player, state, "Rebirths", state.data.Rebirths + 1)
	set(player, state, "Speed", 0)
	set(player, state, "Level", 1)
	applyLevelStats(player, state)
	Notify:FireClient(player, "rebirth", {
		rebirths = state.data.Rebirths,
		multiplier = Config.RebirthMultiplier(state.data.Rebirths),
	})
end

function actions.teleport(player, state, world, stage)
	if type(world) ~= "number" or type(stage) ~= "number" or not Config.Worlds[world] then
		return
	end
	stage = math.floor(stage)
	if state.run then
		toast(player, "텔레포트는 로비에서만 할 수 있어요", RED)
		return
	end
	if state.data.Level < Config.Worlds[world].level then
		toast(player, "🔒 레벨 " .. Config.Worlds[world].level .. "이 필요해요", RED)
		return
	end
	local maxStage = math.min(Config.StagesPerWorld, state.data.BestStages[world] + 1)
	if stage < 1 or stage > maxStage then
		toast(player, "아직 도착하지 못한 스테이지예요", RED)
		return
	end
	local cost = Config.TeleportCost(world, stage)
	if state.data.Trophies < cost then
		toast(player, "🏆 트로피가 부족해요", RED)
		return
	end
	set(player, state, "Trophies", state.data.Trophies - cost)
	startRun(player, state, world, stage)
end

function actions.code(player, state, text)
	if type(text) ~= "string" then
		return
	end
	local code = text:upper():gsub("%s", "")
	local reward = Config.Codes[code]
	if not reward then
		toast(player, "❌ 없는 코드예요", RED)
		return
	end
	if state.data.Codes[code] then
		toast(player, "이미 사용한 코드예요", RED)
		return
	end
	state.data.Codes[code] = true
	if reward.speed then
		addSpeed(player, state, reward.speed)
	end
	if reward.trophies then
		set(player, state, "Trophies", state.data.Trophies + reward.trophies)
	end
	toast(player, "🎟️ 코드 사용! " .. (reward.text or ""), GOLD)
end

function actions.gift(player, state)
	local now = os.time()
	local left = state.data.LastGift + Config.GiftCooldown - now
	if left > 0 then
		if ready(state, "giftWait", 3) then
			toast(player, "🎁 다음 선물까지 " .. math.ceil(left / 60) .. "분", RED)
		end
		return
	end
	local amount = Config.GainPerThrow(speedContext(player, state)) * Config.GiftThrows
	set(player, state, "LastGift", now)
	addSpeed(player, state, amount)
	Notify:FireClient(player, "gift", { speed = amount })
end

ActionRemote.OnServerEvent:Connect(function(player, action, a, b)
	local state = states[player]
	local handler = type(action) == "string" and actions[action]
	if state and handler then
		handler(player, state, a, b)
	end
end)

Passes.OnChanged(function(player, key)
	syncPasses(player)
	local state = states[player]
	if not state then
		return
	end
	local info = Config.GamePasses[key]
	toast(player, "🎉 " .. info.name .. " 구매 완료!", GOLD)
	-- 스킨 게임패스는 사자마자 장착
	for _, skin in ipairs(Config.Skins) do
		if skin.pass == key then
			set(player, state, "Skin", skin.id)
		end
	end
end)

-- 로비: 발판, 포털, 선물 상자 ---------------------------------------------------------------

local function playerFromHit(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	return player, player and states[player]
end

for index, padPart in ipairs(lobby.pads) do
	padPart.Touched:Connect(function(hit)
		local player, state = playerFromHit(hit)
		if not state or index <= state.data.Pad or not ready(state, "pad" .. index, 1.5) then
			return
		end
		local pad = Config.Pads[index]
		if state.data.Trophies < pad.cost then
			toast(player, "🏆 " .. Format.Short(pad.cost) .. " 필요해요", RED)
			return
		end
		set(player, state, "Trophies", state.data.Trophies - pad.cost)
		set(player, state, "Pad", index)
		toast(player, "⚡ 던지기 파워 +" .. Format.Short(pad.value) .. "!", CYAN)
	end)
end

for world, portalPad in ipairs(lobby.portals) do
	portalPad.Touched:Connect(function(hit)
		local player, state = playerFromHit(hit)
		if not state or state.run then
			return
		end
		local need = Config.Worlds[world].level
		if state.data.Level < need then
			if ready(state, "portal" .. world, 2) then
				toast(player, "🔒 월드 " .. world .. "는 레벨 " .. need .. "부터 갈 수 있어요", RED)
			end
			return
		end
		startRun(player, state, world, 1)
	end)
end

lobby.chest.Touched:Connect(function(hit)
	local player, state = playerFromHit(hit)
	if state and ready(state, "chest", 2) then
		actions.gift(player, state)
	end
end)

-- 훈련 허수아비 -----------------------------------------------------------------------------

task.spawn(function()
	while true do
		task.wait(1 / Config.DummyThrowsPerSecond)
		for player, state in pairs(states) do
			local root = not state.run and getCharacterParts(player)
			if root then
				for _, dummy in ipairs(lobby.dummies) do
					local offset = root.Position - dummy.position
					if Vector3.new(offset.X, 0, offset.Z).Magnitude <= Config.DummyRange then
						local info = Config.Dummies[dummy.tier]
						if info.pass and not Passes.Owns(player, info.pass) then
							if ready(state, "dummyLocked", 6) then
								toast(player, "🔒 " .. info.name .. "는 게임패스가 필요해요", RED)
								Passes.Prompt(player, info.pass)
							end
						else
							local gain = Config.GainPerThrow(speedContext(player, state)) * info.mult
							addSpeed(player, state, gain)
							ThrowFx:FireAllClients(player, root.Position + Vector3.new(0, 1.5, 0), dummy.body.Position, nil, gain, state.data.Skin)
						end
						break
					end
				end
			end
		end
	end
end)

-- 적 움직임과 공격 (매 프레임) ------------------------------------------------------------------

-- 적이 길 밖으로 못 나가게. 길보다 큰 적(보스)은 길 가운데에 둡니다
local function clampInside(value, low, high, margin)
	if high - low <= margin * 2 then
		return (low + high) / 2
	end
	return math.clamp(value, low + margin, high - margin)
end

local function updateEnemy(enemy, root, humanoid, map, player, dt, now)
	local position = enemy.part.Position
	local toPlayer = root.Position - position
	local flat = Vector3.new(toPlayer.X, 0, toPlayer.Z)
	local distance = flat.Magnitude
	if distance > Config.EnemyAggroRange or distance < 0.01 then
		return
	end

	local direction = flat.Unit
	local reach = enemy.radius + 2
	local newPosition = position
	if distance > reach then
		newPosition = position + direction * math.min(enemy.speed * dt, distance - reach)
		local bounds = map.bounds
		newPosition = Vector3.new(
			clampInside(newPosition.X, bounds.minX, bounds.maxX, enemy.radius),
			enemy.baseY + math.abs(math.sin(now * 8 + enemy.bobOffset)) * 0.8,
			clampInside(newPosition.Z, bounds.minZ, bounds.maxZ, enemy.radius)
		)
	end
	enemy.part.CFrame = CFrame.lookAt(newPosition, newPosition + direction)

	if distance <= reach + 1 and math.abs(toPlayer.Y) < enemy.radius + 6 and now - enemy.lastAttack >= Config.EnemyAttackCooldown then
		enemy.lastAttack = now
		humanoid:TakeDamage(enemy.damage)
		Notify:FireClient(player, "hurt", { damage = enemy.damage })
	end
end

RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	for player, state in pairs(states) do
		local run = state.run
		if run and run.map then
			local root, humanoid = getCharacterParts(player)
			if root then
				if root.Position.Y < run.origin.Y - 40 then
					humanoid.Health = 0 -- 키보드에서 떨어짐
				else
					for _, enemy in ipairs(run.map.enemies) do
						if not enemy.dead then
							updateEnemy(enemy, root, humanoid, run.map, player, dt, now)
						end
					end
				end
			end
		end
	end
end)

-- 운영자 이벤트: 채팅에 "/event 10 30" (속도 10배 30분), "/event off" -------------------------------

local EVENT_TOPIC = "WakppuEvent"

local function applyEvent(mult, ends)
	workspace:SetAttribute("EventMult", mult)
	workspace:SetAttribute("EventEnds", ends)
	if mult > 1 and ends > os.time() then
		for _, player in ipairs(Players:GetPlayers()) do
			toast(player, "⚡ 운영자 이벤트! 속도 x" .. Format.Short(mult), GOLD)
		end
	end
end

pcall(function()
	MessagingService:SubscribeAsync(EVENT_TOPIC, function(message)
		local payload = message.Data
		if type(payload) == "table" and type(payload.mult) == "number" and type(payload.ends) == "number" then
			applyEvent(payload.mult, payload.ends)
		end
	end)
end)

local function isAdmin(player)
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	return table.find(Config.Admins, player.UserId) ~= nil
end

local function onChatted(player, message)
	if not isAdmin(player) then
		return
	end
	local words = string.split(message, " ")
	if words[1] ~= "/event" then
		return
	end
	local mult, ends
	if words[2] == "off" then
		mult, ends = 1, 0
	else
		mult = math.clamp(tonumber(words[2]) or 2, 1, 1e6)
		ends = os.time() + math.clamp(tonumber(words[3]) or 30, 1, 24 * 60) * 60
	end
	applyEvent(mult, ends)
	pcall(function()
		MessagingService:PublishAsync(EVENT_TOPIC, { mult = mult, ends = ends })
	end)
end

task.spawn(function()
	while true do
		task.wait(1)
		if workspace:GetAttribute("EventMult") ~= 1 and workspace:GetAttribute("EventEnds") <= os.time() then
			workspace:SetAttribute("EventMult", 1)
			for _, player in ipairs(Players:GetPlayers()) do
				toast(player, "운영자 이벤트가 끝났어요", Color3.new(1, 1, 1))
			end
		end
	end
end)

-- 랭킹 보드 ---------------------------------------------------------------------------------

local nameCache = {}

local function nameFor(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("#" .. userId)
	return nameCache[userId]
end

local function refreshBoard()
	local rows = {}
	local ok = false
	if Data.TopStore then
		ok = pcall(function()
			local page = Data.TopStore:GetSortedAsync(false, 10):GetCurrentPage()
			for rank, entry in ipairs(page) do
				rows[rank] = rank .. ". " .. nameFor(tonumber(entry.key)) .. "  ⚡" .. Format.Short(entry.value)
			end
		end)
	end
	if ok and #rows > 0 then
		World.SetBoardRows(lobby.board, "🏆 전체 속도 TOP 10", rows)
		return
	end
	-- 저장이 꺼져 있으면 이 서버 사람들로 보여줍니다
	local list = {}
	for player, state in pairs(states) do
		table.insert(list, { name = player.Name, speed = state.data.Speed })
	end
	table.sort(list, function(a, b)
		return a.speed > b.speed
	end)
	rows = {}
	for rank = 1, math.min(10, #list) do
		rows[rank] = rank .. ". " .. list[rank].name .. "  ⚡" .. Format.Short(list[rank].speed)
	end
	World.SetBoardRows(lobby.board, "🏆 이 서버 속도 TOP", rows)
end

task.spawn(function()
	while true do
		refreshBoard()
		task.wait(Data.TopStore and 60 or 10)
	end
end)

-- 플레이어 입장/퇴장 -------------------------------------------------------------------------

local function onCharacterAdded(player, character)
	local humanoid = character:WaitForChild("Humanoid")
	character:WaitForChild("HumanoidRootPart")
	humanoid.Died:Connect(function()
		onDied(player)
	end)
	local state = states[player]
	if state then
		applyLevelStats(player, state)
		humanoid.Health = humanoid.MaxHealth
		applyAura(player, state)
	end
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	player.Chatted:Connect(function(message)
		onChatted(player, message)
	end)

	local data = Data.Load(player)
	Passes.Load(player)
	if not player.Parent then
		return
	end
	data.Level = Config.LevelFromSpeed(data.Speed)
	data.Unbanked = 0
	data.World = 0
	data.Stage = 0
	data.EnemiesLeft = 0

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	for _, info in ipairs({ { "⚡ 속도", "StringValue" }, { "🏆 트로피", "StringValue" }, { "🔁 환생", "IntValue" } }) do
		local value = Instance.new(info[2])
		value.Name = info[1]
		value.Parent = leaderstats
	end
	leaderstats.Parent = player

	local state = { data = data, lastThrow = 0, run = nil, cooldowns = {} }
	states[player] = state
	updateLeaderstats(player, state)
	for key, value in pairs(data) do
		if type(value) == "table" then
			syncTable(player, state, key)
		else
			player:SetAttribute(key, value)
		end
	end
	syncPasses(player)
	player:SetAttribute("Ready", true)

	if player.Character then
		applyLevelStats(player, state)
		applyAura(player, state)
	end
end

local function onPlayerRemoving(player)
	local state = states[player]
	if not state then
		return
	end
	clearRun(player, state)
	states[player] = nil
	Data.Save(player, state.data)
	Data.Release(player)
	Passes.Release(player)
end

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- 2분마다 자동 저장
task.spawn(function()
	while true do
		task.wait(120)
		for player, state in pairs(states) do
			task.spawn(Data.Save, player, state.data)
		end
	end
end)

game:BindToClose(function()
	if RunService:IsStudio() then
		task.wait(1)
	end
	for player, state in pairs(states) do
		Data.Save(player, state.data)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Passes</string>
          <string name="Source"><![CDATA[--[[
	게임패스 확인과 구매 창 띄우기
	Config.GamePasses의 id가 0이면 아직 만들지 않은 것으로 보고 "준비 중"이라고 알려줍니다.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Passes = {}

local owned = {} -- [player] = { [key] = true }
local changedCallback

local function keyForId(id)
	for key, info in pairs(Config.GamePasses) do
		if info.id == id and id ~= 0 then
			return key
		end
	end
	return nil
end

function Passes.Load(player)
	local result = {}
	local studioFree = Config.StudioOwnsAllPasses and RunService:IsStudio()
	for key, info in pairs(Config.GamePasses) do
		if studioFree then
			result[key] = true
		elseif info.id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, info.id)
			end)
			if ok and has then
				result[key] = true
			end
		end
	end
	owned[player] = result
	return result
end

function Passes.Get(player)
	return owned[player] or {}
end

function Passes.Owns(player, key)
	return key ~= nil and (owned[player] or {})[key] == true
end

-- 구매 창을 띄웁니다. 성공하면 false, 이유 문자열을 돌려줍니다
function Passes.Prompt(player, key)
	local info = Config.GamePasses[key]
	if not info then
		return false, "없는 상품이에요"
	end
	if Passes.Owns(player, key) then
		return false, "이미 가지고 있어요"
	end
	if info.id == 0 then
		return false, "'" .. info.name .. "' 게임패스는 아직 준비 중이에요 (Config.GamePasses에 id를 넣어주세요)"
	end
	MarketplaceService:PromptGamePassPurchase(player, info.id)
	return true
end

function Passes.OnChanged(callback)
	changedCallback = callback
end

function Passes.Release(player)
	owned[player] = nil
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	local key = keyForId(passId)
	if key and owned[player] then
		owned[player][key] = true
		if changedCallback then
			changedCallback(player, key)
		end
	end
end)

return Passes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--[[
	맵을 코드로 만듭니다.
	로비: 스폰, 던지기 파워 발판, 훈련 허수아비 5종, 월드 포털 3개, 무료 선물 상자, 랭킹 보드
	스테이지: 키보드 키로 된 길 → 잠긴 문 → 안전지대(노란 귀환 발판 / 초록 다음 포털)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Format = require(ReplicatedStorage.Shared:WaitForChild("Format"))

local World = {}

local random = Random.new()

local KEY_LETTERS = { "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P", "A", "S", "D", "F", "G", "H", "J", "K", "L", "Z", "X", "C", "V", "B", "N", "M" }

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

-- 파트 위에 떠 있는 글자 (크기는 스터드 단위)
function World.Sign(adornee, text, width, height, offsetY, color)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.new(width, 0, height, 0)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = 250
	gui.LightInfluence = 0

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Text = text
	label.Parent = gui

	gui.Parent = adornee
	return label
end

local sign = World.Sign

local function disc(props)
	-- 원기둥을 눕혀서 납작한 원판으로 씁니다
	local radius = props.Radius
	props.Radius = nil
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(props.Thickness or 0.4, radius * 2, radius * 2)
	props.Thickness = nil
	props.CFrame = CFrame.new(props.Position) * CFrame.Angles(0, 0, math.rad(90))
	props.Position = nil
	return part(props)
end

-- 로비 -------------------------------------------------------------------------

local function buildPortal(folder, position, world)
	local info = Config.Worlds[world]
	local model = Instance.new("Model")
	model.Name = "World" .. world
	model.Parent = folder
	local frameColor = info.bossColor
	for _, x in ipairs({ -9, 9 }) do
		part({ Name = "Pillar", Size = Vector3.new(3, 18, 3), Position = position + Vector3.new(x, 9, 0), Color = frameColor, Material = Enum.Material.SmoothPlastic, Parent = model })
	end
	local top = part({ Name = "Top", Size = Vector3.new(21, 3, 3), Position = position + Vector3.new(0, 19.5, 0), Color = frameColor, Material = Enum.Material.SmoothPlastic, Parent = model })
	part({
		Name = "Glow",
		Size = Vector3.new(15, 16, 0.5),
		Position = position + Vector3.new(0, 9, 0),
		Color = info.dangerColor,
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
		Parent = model,
	})
	local pad = disc({ Name = "Pad", Radius = 8, Position = position + Vector3.new(0, 0.2, 6), Color = info.dangerColor, Material = Enum.Material.Neon, CanCollide = false, Parent = model })
	pad:SetAttribute("World", world)
	local levelText = info.level > 1 and ("🔒 Lv " .. info.level .. " 필요") or "▶ 출발!"
	local label = sign(top, "월드 " .. world .. " · " .. info.name .. "\n" .. levelText, 22, 6, 5, Color3.new(1, 1, 1))
	label.Name = "PortalLabel"
	return pad
end

local function buildDummy(folder, base, tier)
	local info = Config.Dummies[tier]
	local model = Instance.new("Model")
	model.Name = "Dummy" .. tier
	model:SetAttribute("Tier", tier)
	model.Parent = folder
	disc({ Name = "Zone", Radius = Config.DummyRange, Thickness = 0.3, Position = base + Vector3.new(0, 0.1, 0), Color = Color3.fromRGB(255, 235, 120), Material = Enum.Material.Neon, Transparency = 0.55, CanCollide = false, Parent = model })
	part({ Name = "Post", Size = Vector3.new(1, 8, 1), Position = base + Vector3.new(0, 4, 0), Color = Color3.fromRGB(120, 85, 55), Material = Enum.Material.Wood, Parent = model })
	local body = part({ Name = "Body", Size = Vector3.new(4, 4, 2), Position = base + Vector3.new(0, 6, 0), Color = info.color, Material = Enum.Material.SmoothPlastic, Parent = model })
	part({ Name = "Arms", Size = Vector3.new(8, 1, 1), Position = base + Vector3.new(0, 7, 0), Color = Color3.fromRGB(120, 85, 55), Material = Enum.Material.Wood, Parent = model })
	local head = part({ Name = "Head", Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3), Position = base + Vector3.new(0, 9.5, 0), Color = info.color, Material = Enum.Material.SmoothPlastic, Parent = model })
	local face = Instance.new("Decal")
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = head
	sign(head, info.name .. "\n훈련 x" .. info.mult, 12, 3.5, 4, Color3.new(1, 1, 1))
	return { model = model, body = body, tier = tier, position = base }
end

function World.BuildLobby()
	local folder = Instance.new("Folder")
	folder.Name = "Lobby"
	folder.Parent = workspace

	part({ Name = "Ground", Size = Vector3.new(220, 2, 220), Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(110, 200, 100), Material = Enum.Material.Grass, Parent = folder })
	for _, info in ipairs({
		{ Vector3.new(0, 2, 110), Vector3.new(220, 4, 2) },
		{ Vector3.new(0, 2, -110), Vector3.new(220, 4, 2) },
		{ Vector3.new(110, 2, 0), Vector3.new(2, 4, 220) },
		{ Vector3.new(-110, 2, 0), Vector3.new(2, 4, 220) },
	}) do
		part({ Name = "Fence", Position = info[1], Size = info[2], Color = Color3.fromRGB(150, 105, 70), Material = Enum.Material.Wood, Parent = folder })
	end

	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "Spawn"
	spawnLocation.Anchored = true
	spawnLocation.Size = Vector3.new(12, 1, 12)
	spawnLocation.Position = Vector3.new(0, 0.5, 0)
	spawnLocation.Color = Color3.fromRGB(255, 170, 210)
	spawnLocation.Material = Enum.Material.SmoothPlastic
	spawnLocation.Neutral = true
	spawnLocation.Duration = 0
	spawnLocation.TopSurface = Enum.SurfaceType.Smooth
	spawnLocation.Parent = folder

	local title = part({ Name = "Title", Size = Vector3.new(1, 1, 1), Position = Vector3.new(0, 24, -20), Transparency = 1, CanCollide = false, Parent = folder })
	sign(title, "🎯 " .. Config.GameName, 50, 10, 0, Color3.fromRGB(255, 220, 120))

	-- 던지기 파워 발판 (스폰 앞쪽)
	local padFolder = Instance.new("Folder")
	padFolder.Name = "Pads"
	padFolder.Parent = folder
	local pads = {}
	local padCount = #Config.Pads
	for index, pad in ipairs(Config.Pads) do
		local x = (index - (padCount + 1) / 2) * 11
		local padPart = part({
			Name = "Pad" .. index,
			Size = Vector3.new(9, 1, 9),
			Position = Vector3.new(x, 0.5, -30),
			Color = Color3.fromRGB(255, 200, 60),
			Material = Enum.Material.Neon,
			Parent = padFolder,
		})
		padPart:SetAttribute("PadIndex", index)
		sign(padPart, "+" .. Format.Short(pad.value) .. "\n🏆 " .. Format.Short(pad.cost), 7, 4, 4, Color3.new(1, 1, 1))
		pads[index] = padPart
	end
	local padTitle = part({ Name = "PadTitle", Size = Vector3.new(1, 1, 1), Position = Vector3.new(0, 11, -30), Transparency = 1, CanCollide = false, Parent = folder })
	sign(padTitle, "⚡ 던지기 파워 · 밟아서 구매", 34, 4, 0, Color3.fromRGB(255, 240, 160))

	-- 훈련 허수아비 (스폰 뒤쪽, 원작의 트레드밀 자리)
	local dummyFolder = Instance.new("Folder")
	dummyFolder.Name = "Dummies"
	dummyFolder.Parent = folder
	local dummies = {}
	for tier = 1, #Config.Dummies do
		local x = (tier - (#Config.Dummies + 1) / 2) * 20
		dummies[tier] = buildDummy(dummyFolder, Vector3.new(x, 0, 32), tier)
	end
	local dummyTitle = part({ Name = "DummyTitle", Size = Vector3.new(1, 1, 1), Position = Vector3.new(0, 18, 32), Transparency = 1, CanCollide = false, Parent = folder })
	sign(dummyTitle, "🥊 훈련장 · 노란 원 안에 서 있으면 자동 훈련", 44, 4, 0, Color3.fromRGB(255, 240, 160))

	-- 월드 포털 (맨 뒤)
	local portalFolder = Instance.new("Folder")
	portalFolder.Name = "Portals"
	portalFolder.Parent = folder
	local portals = {}
	for world = 1, #Config.Worlds do
		local x = (world - (#Config.Worlds + 1) / 2) * 40
		portals[world] = buildPortal(portalFolder, Vector3.new(x, 0, -80), world)
	end

	-- 무료 선물 상자
	local chest = part({ Name = "GiftChest", Size = Vector3.new(8, 6, 6), Position = Vector3.new(-70, 3, 0), Color = Color3.fromRGB(230, 70, 90), Material = Enum.Material.SmoothPlastic, Parent = folder })
	part({ Name = "Ribbon", Size = Vector3.new(1.5, 6.2, 6.2), Position = Vector3.new(-70, 3, 0), Color = Color3.fromRGB(255, 220, 80), Material = Enum.Material.Neon, CanCollide = false, Parent = folder })
	sign(chest, "🎁 무료 선물\n밟으면 받기", 14, 5, 6, Color3.fromRGB(255, 240, 160))

	-- 랭킹 보드
	local board = part({ Name = "Leaderboard", Size = Vector3.new(1, 26, 20), Position = Vector3.new(80, 13, 0), Color = Color3.fromRGB(40, 35, 60), Material = Enum.Material.SmoothPlastic, Parent = folder })

	return {
		folder = folder,
		spawnCFrame = spawnLocation.CFrame + Vector3.new(0, 4, 0),
		pads = pads,
		dummies = dummies,
		portals = portals,
		chest = chest,
		board = board,
	}
end

-- 스테이지 ------------------------------------------------------------------------

local function pickEnemyType(stage)
	local pool, total = {}, 0
	for index, enemyType in ipairs(Config.EnemyTypes) do
		if stage >= enemyType.minStage then
			table.insert(pool, index)
			total += enemyType.weight
		end
	end
	local roll = random:NextNumber(0, total)
	for _, index in ipairs(pool) do
		roll -= Config.EnemyTypes[index].weight
		if roll <= 0 then
			return index
		end
	end
	return pool[#pool]
end

local function createEnemy(folder, spec)
	local size = spec.size
	local body = part({
		Name = spec.name,
		Shape = spec.shape == "Ball" and Enum.PartType.Ball or Enum.PartType.Block,
		Size = Vector3.new(size, size, size),
		CFrame = CFrame.new(spec.position),
		Color = spec.color,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})

	local face = Instance.new("Decal")
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = body

	local gui = Instance.new("BillboardGui")
	gui.Size = spec.boss and UDim2.fromOffset(220, 56) or UDim2.fromOffset(110, 34)
	gui.StudsOffset = Vector3.new(0, size / 2 + 1.5, 0)
	gui.MaxDistance = spec.boss and 250 or 120
	gui.Parent = body

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.FredokaOne
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = spec.boss and Color3.fromRGB(255, 220, 90) or Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.2
	nameLabel.Text = spec.boss and ("👑 " .. spec.name) or spec.name
	nameLabel.Parent = gui

	local barBack = Instance.new("Frame")
	barBack.Position = UDim2.new(0, 0, 0.55, 0)
	barBack.Size = UDim2.new(1, 0, 0.4, 0)
	barBack.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	barBack.BorderSizePixel = 0
	barBack.Parent = gui

	local bar = Instance.new("Frame")
	bar.Size = UDim2.fromScale(1, 1)
	bar.BackgroundColor3 = Color3.fromRGB(240, 80, 80)
	bar.BorderSizePixel = 0
	bar.Parent = barBack

	local hpLabel = Instance.new("TextLabel")
	hpLabel.Size = UDim2.fromScale(1, 1)
	hpLabel.BackgroundTransparency = 1
	hpLabel.Font = Enum.Font.FredokaOne
	hpLabel.TextScaled = true
	hpLabel.TextColor3 = Color3.new(1, 1, 1)
	hpLabel.Text = Format.Short(spec.health)
	hpLabel.ZIndex = 2
	hpLabel.Parent = barBack

	return {
		part = body,
		health = spec.health,
		maxHealth = spec.health,
		damage = spec.damage,
		speed = spec.speed,
		radius = size / 2,
		baseY = spec.position.Y,
		bobOffset = random:NextNumber(0, math.pi * 2),
		lastAttack = 0,
		dead = false,
		boss = spec.boss,
		bar = bar,
		hpLabel = hpLabel,
	}
end

function World.UpdateEnemyBar(enemy)
	local ratio = math.clamp(enemy.health / enemy.maxHealth, 0, 1)
	enemy.bar.Size = UDim2.fromScale(ratio, 1)
	enemy.hpLabel.Text = Format.Short(math.max(0, enemy.health))
end

function World.KillEnemy(enemy)
	local body = enemy.part
	body.CanCollide = false
	local gui = body:FindFirstChildOfClass("BillboardGui")
	if gui then
		gui:Destroy()
	end
	TweenService:Create(body, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(body, 0.3)
end

-- 키보드 키처럼 생긴 길. 일부 줄은 비워서 점프 구간을 만듭니다
local function buildKeyPath(folder, origin, stage, worldInfo, length, width)
	local rowDepth = 4
	local rows = math.floor(length / rowDepth)
	local columns = math.max(2, math.floor(width / 6 + 0.5))
	local keyWidth = width / columns

	local gapRows = {}
	local gapCount = Config.GapCount(stage)
	for g = 1, gapCount do
		-- 시작 부분과 끝 부분을 피해서 고르게 배치
		local row = math.floor(rows * g / (gapCount + 1))
		if row > 4 and row < rows - 3 then
			gapRows[row] = true
		end
	end

	local t = (stage - 1) / math.max(1, Config.StagesPerWorld - 1)
	for row = 0, rows - 1 do
		if not gapRows[row] then
			for column = 0, columns - 1 do
				local x = -width / 2 + keyWidth * (column + 0.5)
				local z = -10 - rowDepth * (row + 0.5)
				local base = worldInfo.keyColors[(row + column) % 2 + 1]
				local key = part({
					Name = "Key",
					Size = Vector3.new(keyWidth - 0.35, 1.6, rowDepth - 0.35),
					Position = origin + Vector3.new(x, -0.8, z),
					Color = base:Lerp(worldInfo.dangerColor, t * 0.6),
					Material = Enum.Material.SmoothPlastic,
					Parent = folder,
				})
				if (row * columns + column) % 7 == 0 then
					local surface = Instance.new("SurfaceGui")
					surface.Face = Enum.NormalId.Top
					surface.CanvasSize = Vector2.new(100, 100)
					surface.LightInfluence = 0
					local letter = Instance.new("TextLabel")
					letter.Size = UDim2.fromScale(1, 1)
					letter.BackgroundTransparency = 1
					letter.Font = Enum.Font.FredokaOne
					letter.TextScaled = true
					letter.TextColor3 = Color3.fromRGB(80, 80, 100)
					letter.TextTransparency = 0.3
					letter.Text = KEY_LETTERS[random:NextInteger(1, #KEY_LETTERS)]
					letter.Parent = surface
					surface.Parent = key
				end
			end
		end
	end
	return rows * rowDepth
end

--[[
	origin: 스테이지 시작점 (길 윗면 높이). 스테이지는 origin에서 -Z 방향으로 뻗어 있습니다.
	[출발 발판] → [키보드 길 + 적] → [잠긴 문] → [안전지대: 노란 귀환 발판 / 초록 다음 포털]
]]
function World.BuildStage(origin, world, stage, ownerName)
	local worldInfo = Config.Worlds[world]
	local folder = Instance.new("Folder")
	folder.Name = ownerName .. "_W" .. world .. "S" .. stage
	folder.Parent = workspace

	local width = Config.PathWidth(stage)
	local length = buildKeyPath(folder, origin, stage, worldInfo, Config.PathLength(stage), width)
	local endZ = -10 - length

	local function at(x, y, z)
		return origin + Vector3.new(x, y, z)
	end

	local startPad = part({ Name = "Start", Size = Vector3.new(26, 2, 20), Position = at(0, -1, 0), Color = Color3.fromRGB(235, 235, 245), Material = Enum.Material.SmoothPlastic, Parent = folder })
	sign(startPad, "월드 " .. world .. " · 스테이지 " .. stage .. " / " .. Config.StagesPerWorld, 22, 4, 8, Color3.new(1, 1, 1))

	-- 안전지대
	part({ Name = "SafeZone", Size = Vector3.new(44, 2, 36), Position = at(0, -1, endZ - 18), Color = Color3.fromRGB(235, 235, 245), Material = Enum.Material.SmoothPlastic, Parent = folder })

	local gate = part({ Name = "Gate", Size = Vector3.new(44, 22, 2), Position = at(0, 11, endZ - 2), Color = Color3.fromRGB(230, 70, 70), Material = Enum.Material.Neon, Transparency = 0.35, Parent = folder })
	local gateLabel = sign(gate, "", 22, 4, 14, Color3.fromRGB(255, 225, 225))

	local isLast = stage >= Config.StagesPerWorld
	local bankPad = part({
		Name = "BankPad",
		Size = Vector3.new(12, 1, 12),
		Position = at(isLast and 0 or -11, 0.5, endZ - 20),
		Color = Color3.fromRGB(255, 215, 50),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	sign(bankPad, isLast and "👑 월드 클리어!\n🟡 귀환 · 트로피 받기" or "🟡 귀환\n트로피 받기", 12, 5, 5, Color3.fromRGB(255, 245, 180))

	local nextPortal
	if not isLast then
		nextPortal = part({
			Name = "NextPortal",
			Size = Vector3.new(12, 1, 12),
			Position = at(11, 0.5, endZ - 20),
			Color = Color3.fromRGB(80, 230, 120),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
		part({ Name = "NextArch", Size = Vector3.new(12, 14, 1), Position = at(11, 7, endZ - 27), Color = Color3.fromRGB(80, 230, 120), Material = Enum.Material.Neon, Transparency = 0.4, CanCollide = false, Parent = folder })
		sign(
			nextPortal,
			"🟢 전진 ▶ 스테이지 " .. (stage + 1) .. "\n권장 Lv " .. Format.Short(Config.RecommendedLevel(world, stage + 1)),
			12,
			5,
			5,
			Color3.fromRGB(200, 255, 210)
		)
	end

	-- 적 배치
	local enemyFolder = Instance.new("Folder")
	enemyFolder.Name = "Enemies"
	enemyFolder.Parent = folder

	local enemies = {}
	local count = Config.EnemyCount(world, stage)
	local health = Config.EnemyHealth(world, stage)
	local damage = Config.EnemyDamage(world, stage)
	local firstZ, lastZ = -40, endZ + 25
	for i = 1, count do
		local typeIndex = pickEnemyType(stage)
		local enemyType = Config.EnemyTypes[typeIndex]
		local t = count == 1 and 0.5 or (i - 1) / (count - 1)
		local z = firstZ + (lastZ - firstZ) * t + random:NextNumber(-5, 5)
		local halfRoom = math.max(0, width / 2 - enemyType.size / 2 - 1)
		table.insert(enemies, createEnemy(enemyFolder, {
			name = worldInfo.enemyNames[typeIndex] or enemyType.id,
			shape = enemyType.shape,
			size = enemyType.size,
			color = enemyType.color:Lerp(worldInfo.bossColor, 0.3),
			position = at(random:NextNumber(-halfRoom, halfRoom), enemyType.size / 2, z),
			health = math.max(1, math.floor(health * enemyType.health)),
			damage = math.ceil(damage * enemyType.damage),
			speed = enemyType.speed,
		}))
	end

	if isLast then
		local boss = Config.Boss
		table.insert(enemies, createEnemy(enemyFolder, {
			name = worldInfo.bossName,
			shape = "Ball",
			size = boss.size,
			color = worldInfo.bossColor,
			position = at(0, boss.size / 2, endZ + 14),
			health = health * boss.health,
			damage = damage * boss.damage,
			speed = boss.speed,
			boss = true,
		}))
	end

	local map = {
		folder = folder,
		world = world,
		stage = stage,
		enemies = enemies,
		gate = gate,
		gateLabel = gateLabel,
		bankPad = bankPad,
		nextPortal = nextPortal,
		startCFrame = CFrame.lookAt(at(0, 4, 0), at(0, 4, -10)),
		bounds = {
			minX = origin.X - width / 2,
			maxX = origin.X + width / 2,
			minZ = origin.Z + endZ + 2,
			maxZ = origin.Z - 12,
		},
	}
	World.UpdateGate(map, #enemies)
	return map
end

function World.UpdateGate(map, enemiesLeft)
	if enemiesLeft > 0 then
		map.gateLabel.Text = "🔒 남은 적 " .. enemiesLeft
		return
	end
	map.gateLabel.Text = "🚪 출구 열림!"
	map.gate.CanCollide = false
	map.gate.Color = Color3.fromRGB(90, 230, 120)
	TweenService:Create(map.gate, TweenInfo.new(0.6), { Transparency = 0.85 }):Play()
end

-- 랭킹 보드 내용 ----------------------------------------------------------------

function World.SetBoardRows(board, title, rows)
	local surface = board:FindFirstChild("BoardGui")
	if not surface then
		surface = Instance.new("SurfaceGui")
		surface.Name = "BoardGui"
		surface.Face = Enum.NormalId.Left
		surface.CanvasSize = Vector2.new(400, 520)
		surface.LightInfluence = 0
		surface.Parent = board

		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0, 4)
		layout.Parent = surface
	end
	for _, child in ipairs(surface:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local function line(order, text, color, height)
		local label = Instance.new("TextLabel")
		label.LayoutOrder = order
		label.Size = UDim2.new(1, 0, 0, height)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = color
		label.Text = text
		label.Parent = surface
	end
	line(0, title, Color3.fromRGB(255, 220, 90), 60)
	for i, row in ipairs(rows) do
		local color = i == 1 and Color3.fromRGB(255, 215, 60)
			or i == 2 and Color3.fromRGB(220, 220, 230)
			or i == 3 and Color3.fromRGB(230, 160, 100)
			or Color3.new(1, 1, 1)
		line(i, row, color, 40)
	end
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="10">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="11">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--[[
	연출: 볼 날아가기, 숫자 팝업, 타격 이펙트, 화면 흔들림, 효과음
	모두 내 화면에서만 만들어지는 것이라 서버 부하가 없습니다.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer

local Effects = {}

local MAX_BALLS = 50

local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientEffects"
fxFolder.Parent = workspace

local activeBalls = 0

local ballTemplate = Instance.new("Part")
ballTemplate.Name = "Ball"
ballTemplate.Shape = Enum.PartType.Ball
ballTemplate.Size = Vector3.new(1.6, 1.6, 1.6)
ballTemplate.Color = Color3.fromRGB(255, 130, 190)
ballTemplate.Material = Enum.Material.Neon
ballTemplate.Anchored = true
ballTemplate.CanCollide = false
ballTemplate.CanTouch = false
ballTemplate.CanQuery = false
ballTemplate.CastShadow = false

-- 효과음 (Roblox 기본 내장 소리)
local function makeSound(id, volume)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.Parent = fxFolder
	return sound
end

local sounds = {
	throw = makeSound("rbxasset://sounds/swoosh.wav", 0.35),
	hit = makeSound("rbxasset://sounds/electronicpingshort.wav", 0.25),
	levelUp = makeSound("rbxasset://sounds/electronicpingshort.wav", 0.6),
	death = makeSound("rbxasset://sounds/uuhhh.mp3", 0.7),
	click = makeSound("rbxasset://sounds/button.wav", 0.5),
}

-- 연속으로 던질수록 효과음이 높아집니다
local combo = 0
local lastComboTime = 0

function Effects.PlayThrow()
	local now = os.clock()
	if now - lastComboTime > 1.2 then
		combo = 0
	end
	combo += 1
	lastComboTime = now
	sounds.throw.PlaybackSpeed = 0.9 + math.min(0.9, combo * 0.015)
	sounds.throw:Play()
end

function Effects.PlayHit()
	sounds.hit.PlaybackSpeed = 1.4 + math.random() * 0.2
	sounds.hit:Play()
end

function Effects.PlayLevelUp()
	sounds.levelUp.PlaybackSpeed = 2
	sounds.levelUp:Play()
end

function Effects.PlayDeath()
	sounds.death:Play()
end

function Effects.PlayClick()
	sounds.click:Play()
end

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
	ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 230, 80)),
	ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 220, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 90, 255)),
})

-- 장착한 스킨 색과 꼬리(트레일)를 단 볼
local function makeBall(skinId)
	local skin = Config.FindById(Config.Skins, skinId) or Config.Skins[1]
	local ball = ballTemplate:Clone()
	ball.Color = skin.color
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.5, 0)
	a0.Parent = ball
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.5, 0)
	a1.Parent = ball
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.25
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Color = skin.rainbow and RAINBOW or ColorSequence.new(skin.color)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Parent = ball
	return ball, skin
end

-- 포물선을 그리며 날아가는 볼
function Effects.Throw(from, to, skinId, onArrive)
	if activeBalls >= MAX_BALLS then
		if onArrive then
			onArrive()
		end
		return
	end
	activeBalls += 1

	local ball, skin = makeBall(skinId)
	ball.Position = from
	ball.Parent = fxFolder

	local distance = (to - from).Magnitude
	local duration = math.clamp(distance / 140, 0.08, 0.35)
	local arc = math.min(6, distance * 0.15)
	local startTime = os.clock()

	local connection
	connection = RunService.RenderStepped:Connect(function()
		local alpha = math.min(1, (os.clock() - startTime) / duration)
		local position = from:Lerp(to, alpha) + Vector3.new(0, math.sin(alpha * math.pi) * arc, 0)
		ball.CFrame = CFrame.new(position) * CFrame.Angles(alpha * 12, 0, 0)
		if skin.rainbow then
			ball.Color = Color3.fromHSV((os.clock() * 2) % 1, 0.8, 1)
		end
		if alpha >= 1 then
			connection:Disconnect()
			ball:Destroy()
			activeBalls -= 1
			if onArrive then
				onArrive()
			end
		end
	end)
end

-- 맞은 자리에 퍼지는 동그라미
function Effects.Burst(position, color)
	local burst = ballTemplate:Clone()
	burst.Size = Vector3.new(1, 1, 1)
	burst.Color = color or Color3.fromRGB(255, 240, 150)
	burst.Position = position
	burst.Transparency = 0.2
	burst.Parent = fxFolder
	TweenService:Create(burst, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(5, 5, 5),
		Transparency = 1,
	}):Play()
	Debris:AddItem(burst, 0.3)
end

-- 위로 떠오르며 사라지는 숫자
function Effects.Popup(position, text, color, scale)
	scale = scale or 1
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Position = position + Vector3.new(math.random() * 2 - 1, 1, math.random() * 2 - 1)
	anchor.Parent = fxFolder

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(120 * scale, 44 * scale)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = anchor

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Parent = gui

	local info = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(gui, info, { StudsOffset = Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 0.75)
end

-- 화면 흔들림
local shake = 0

function Effects.Shake(amount)
	shake = math.max(shake, amount)
end

RunService.RenderStepped:Connect(function()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if shake > 0.01 then
		humanoid.CameraOffset = Vector3.new(
			(math.random() * 2 - 1) * shake,
			(math.random() * 2 - 1) * shake,
			0
		)
		shake *= 0.82
	elseif humanoid.CameraOffset ~= Vector3.zero then
		shake = 0
		humanoid.CameraOffset = Vector3.zero
	end
end)

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="14">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	왁뿌볼 던지기 — 클라이언트 화면
	왼쪽: 상점 · 텔레포트 · 코드 · 선물   오른쪽: 환생 · 자동
	위: 트로피, 운영자 이벤트, 스테이지 정보(미수령 트로피)   아래: 속도 + 던지기 버튼
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local Ui = require(script.Parent:WaitForChild("Ui"))
local State = require(script.Parent:WaitForChild("State"))
