-- 사망 연출: 미수령 트로피가 한꺼번에 사라지는 모습을 확실히 보여줍니다
local function showDeath(info)
	Menus.CloseAll()
	Effects.PlayDeath()
	Effects.Shake(1)
	deathOverlay.Visible = true
	deathOverlay.BackgroundTransparency = 0.35
	deathTitle.TextTransparency = 0
	deathLost.TextTransparency = 0
	deathLost.TextColor3 = C.gold
	deathKept.Text = (info.kept or 0) > 0 and ("🛡️ 사망 보험으로 " .. Format.Short(info.kept) .. " 지켰어요") or ""

	local lost = info.lost or 0
	if lost > 0 then
		deathLost.Text = "💰 미수령 트로피 " .. Format.Short(lost)
		task.wait(0.6)
		local steps = 20
		for i = steps - 1, 0, -1 do
			deathLost.Text = "💰 미수령 트로피 " .. Format.Short(math.floor(lost * i / steps))
			task.wait(0.04)
		end
		deathLost.TextColor3 = C.red
		deathLost.Text = "-" .. Format.Short(lost) .. " 트로피 전부 사라졌다…"
		Ui.Pop(deathLost, 1.4)
	else
		deathLost.Text = "스테이지 " .. (info.stage or 1) .. "에서 쓰러졌어요"
	end

	task.wait(1.6)
	local fade = TweenInfo.new(0.8)
	TweenService:Create(deathOverlay, fade, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(deathTitle, fade, { TextTransparency = 1 }):Play()
	TweenService:Create(deathLost, fade, { TextTransparency = 1 }):Play()
	task.wait(0.8)
	deathOverlay.Visible = false
end

Menus.Init(screen, ActionRemote)

-- 로비 표지판을 내 상태에 맞게 (구매한 발판, 잠긴 허수아비/월드) -------------------------------------

local lobby

local function updateLobby()
	if not lobby then
		return
	end
	local ownedPad = State.Get("Pad")
	local trophies = State.Get("Trophies")
	local pads = lobby:FindFirstChild("Pads")
	for _, padPart in ipairs(pads and pads:GetChildren() or {}) do
		local index = padPart:GetAttribute("PadIndex")
		local pad = index and Config.Pads[index]
		local label = padPart:FindFirstChild("Sign") and padPart.Sign:FindFirstChild("Label")
		if pad and label then
			if index <= ownedPad then
				label.Text = "✔ +" .. Format.Short(pad.value)
				padPart.Color = C.green
			else
				label.Text = "+" .. Format.Short(pad.value) .. "\n🏆 " .. Format.Short(pad.cost)
				padPart.Color = trophies >= pad.cost and C.gold or C.disabled
			end
		end
	end

	local dummies = lobby:FindFirstChild("Dummies")
	for _, model in ipairs(dummies and dummies:GetChildren() or {}) do
		local info = Config.Dummies[model:GetAttribute("Tier") or 0]
		local head = model:FindFirstChild("Head")
		local label = head and head:FindFirstChild("Sign") and head.Sign:FindFirstChild("Label")
		if info and label then
			local locked = info.pass and not State.OwnsPass(info.pass)
			label.Text = (locked and "🔒 " or "") .. info.name .. "\n훈련 x" .. info.mult
		end
	end

	local portals = lobby:FindFirstChild("Portals")
	local level = State.Get("Level")
	for world, info in ipairs(Config.Worlds) do
		local model = portals and portals:FindFirstChild("World" .. world)
		local top = model and model:FindFirstChild("Top")
		local label = top and top:FindFirstChild("Sign") and top.Sign:FindFirstChild("PortalLabel")
		if label then
			local status = level >= info.level and "▶ 출발!" or ("🔒 Lv " .. info.level .. " 필요")
			label.Text = "월드 " .. world .. " · " .. info.name .. "\n" .. status
		end
	end
end

task.spawn(function()
	lobby = workspace:WaitForChild("Lobby", 30)
	if lobby then
		lobby:WaitForChild("Pads", 10)
		lobby:WaitForChild("Portals", 10)
		updateLobby()
	end
end)

-- 화면 갱신 ----------------------------------------------------------------------------------

local lastUnbanked = 0

local function refresh()
	local speed = State.Get("Speed")
	local level = math.max(1, State.Get("Level"))
	local rebirths = State.Get("Rebirths")
	local stage = State.Get("Stage")
	local world = State.Get("World")
	local inRun = stage > 0 and Config.Worlds[world] ~= nil

	trophyLabel.Text = "🏆 " .. Format.Short(State.Get("Trophies"))

	speedLabel.Text = "⚡ " .. Format.Short(speed) .. "  (+" .. Format.Short(State.Gain()) .. ")"
	local current, nextSpeed = Config.SpeedForLevel(level), Config.SpeedForLevel(level + 1)
	levelFill.Size = UDim2.fromScale(math.clamp((speed - current) / math.max(1, nextSpeed - current), 0, 1), 1)
	levelText.Text = "Lv " .. level .. "  ·  다음까지 " .. Format.Short(math.max(0, nextSpeed - speed))

	local need = Config.RebirthLevel(rebirths)
	rebirthCaption.Text = "Lv " .. level .. "/" .. need
	rebirthBadge.Visible = level >= need and not inRun

	local giftLeft = State.Get("LastGift") + Config.GiftCooldown - os.time()
	giftBadge.Visible = giftLeft <= 0
	giftCaption.Text = giftLeft <= 0 and "선물!" or string.format("%d:%02d", giftLeft // 3600, (giftLeft % 3600) // 60)

	local eventMult = State.EventMultiplier()
	eventBanner.Visible = eventMult > 1
	if eventMult > 1 then
		local left = (workspace:GetAttribute("EventEnds") or 0) - os.time()
		eventLabel.Text = string.format("⚡ 운영자 이벤트! 속도 x%s · %d:%02d", Format.Short(eventMult), left // 60, left % 60)
	end

	runPanel.Visible = inRun
	runPanel.Position = UDim2.new(0.5, 0, 0, eventMult > 1 and 116 or 72)
	if inRun then
		local enemiesLeft = State.Get("EnemiesLeft")
		stageLabel.Text = "월드 " .. world .. " · 스테이지 " .. stage .. "/" .. Config.StagesPerWorld .. "  ·  " .. (enemiesLeft > 0 and ("👾 " .. enemiesLeft) or "🚪 출구 열림")
		local recommended = Config.RecommendedLevel(world, stage)
		recommendedLabel.Text = "권장 Lv " .. Format.Short(recommended) .. "  (내 Lv " .. level .. ")"
		recommendedLabel.TextColor3 = level >= recommended and Color3.fromRGB(170, 255, 170) or Color3.fromRGB(255, 150, 150)
		if enemiesLeft > 0 then
			runHint.Text = "미수령 트로피 · 죽으면 전부 사라져요!"
		end
	end
	local unbanked = State.Get("Unbanked")
	unbankedLabel.Text = "💰 " .. Format.Short(unbanked)
	if unbanked > lastUnbanked then
		Ui.Pop(unbankedLabel, 1.4)
	end
	lastUnbanked = unbanked
end

local LOBBY_KEYS = { Pad = true, Trophies = true, Level = true, PassesJson = true }

State.OnChanged(function(name)
	refresh()
	if name then
		Menus.OnAttributeChanged(name)
		if LOBBY_KEYS[name] then
			updateLobby()
		end
	end
end)
refresh()

-- 선물/이벤트 시간 표시를 위해 1초마다 갱신
task.spawn(function()
	while true do
		task.wait(1)
		refresh()
	end
end)

-- 던지기 ------------------------------------------------------------------------------------

local lastThrow = 0

local function tryThrow()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local now = os.clock()
	if now - lastThrow < 1 / Config.ThrowsPerSecond(State.Get("Speed")) then
		return
	end
	lastThrow = now
	ThrowRemote:FireServer()
end

throwButton.Activated:Connect(tryThrow)

-- 화면 아무 데나 클릭/터치해도 던집니다 (UI 버튼 위는 제외)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		tryThrow()
	end
end)

autoButton.Activated:Connect(function()
	if not State.CanAutoThrow() then
		ActionRemote:FireServer("buyPass", "AutoThrow")
		return
	end
	autoOn = not autoOn
	autoCaption.Text = autoOn and "자동 켬" or "자동 끔"
	autoButton.BackgroundColor3 = autoOn and C.green or C.disabled
end)

task.spawn(function()
	while true do
		task.wait(1 / Config.ThrowsPerSecond(State.Get("Speed")))
		if autoOn and State.CanAutoThrow() then
			tryThrow()
		end
	end
end)

ThrowFx.OnClientEvent:Connect(function(thrower, from, to, damage, gain, skinId)
	local mine = thrower == player
	if mine then
		Effects.PlayThrow()
	end
	Effects.Throw(from, to, skinId, function()
		if damage then
			Effects.Burst(to)
			if mine then
				Effects.Popup(to, Format.Short(damage), C.gold, 1)
				Effects.PlayHit()
				Effects.Shake(0.15)
			end
		elseif mine then
			Effects.Popup(to, "+" .. Format.Short(gain) .. " ⚡", C.speed, 0.8)
		end
	end)
end)

-- 서버 알림 ----------------------------------------------------------------------------------

Notify.OnClientEvent:Connect(function(kind, info)
	info = info or {}
	if kind == "toast" then
		showToast(info.text, info.color)
	elseif kind == "levelUp" then
		showToast("⭐ 레벨 업! Lv " .. info.level, C.speed)
		Effects.PlayLevelUp()
		Ui.Pop(levelBar, 1.2)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			Effects.Burst(root.Position, C.speed)
		end
	elseif kind == "stageStart" then
		Menus.CloseAll()
		showToast("월드 " .. info.world .. " · 스테이지 " .. info.stage .. " 시작! 적을 전부 쓰러뜨리세요", C.text)
	elseif kind == "cleared" then
		showToast("🎉 스테이지 " .. info.stage .. " 클리어! 미수령 +" .. Format.Short(info.reward), C.gold)
		if info.isLast then
			runHint.Text = "👑 월드 클리어! 🟡 노란 발판에서 트로피 받기"
		else
			runHint.Text = "🟡 귀환 = 받기 · 🟢 전진 = 권장 Lv " .. Format.Short(info.nextRecommended)
		end
	elseif kind == "banked" then
		if (info.amount or 0) > 0 then
			showToast("🏆 트로피 +" .. Format.Short(info.amount) .. " 받았어요!", C.gold)
			Ui.Pop(trophyPill, 1.3)
		end
	elseif kind == "death" then
		task.spawn(showDeath, info)
	elseif kind == "hurt" then
		Effects.Shake(0.5)
	elseif kind == "rebirth" then
		Menus.CloseAll()
		showToast("🔁 환생 완료! 이제 속도 x" .. Format.Short(info.multiplier), Color3.fromRGB(220, 180, 255))
		Effects.PlayLevelUp()
	elseif kind == "newSkin" then
		showReward("✨ 새 " .. Config.BallName .. "!", info.id)
	elseif kind == "gift" then
		showToast("🎁 선물! 속도 +" .. Format.Short(info.speed), C.pink)
		Effects.PlayLevelUp()
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Menus</string>
            <string name="Source"><![CDATA[--[[
	창(메뉴): 상점(왁뿌볼/오라/게임패스), 텔레포트, 코드, 환생
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Ui = require(script.Parent:WaitForChild("Ui"))
local State = require(script.Parent:WaitForChild("State"))

local C = Ui.Colors
local create = Ui.Create

local Menus = {}

local windows = {} -- [name] = { frame, refresh }
local ActionRemote

local function clearGrid(grid)
	for _, child in ipairs(grid:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- 상점 카드 하나
local function card(grid, order, info)
	local frame = Ui.Panel({
		Name = "Card" .. order,
		LayoutOrder = order,
		BackgroundColor3 = C.panelLight,
		BackgroundTransparency = 0,
		Parent = grid,
	})
	if info.highlight then
		local stroke = frame:FindFirstChildOfClass("UIStroke")
		stroke.Color = C.gold
		stroke.Thickness = 4
	end

	local rarity = info.rarity and Config.Rarities[info.rarity]
	if rarity then
		local strip = create("Frame", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundColor3 = rarity.color,
			Parent = frame,
		}, { Ui.Corner(14) })
		Ui.Text({ Size = UDim2.fromScale(1, 1), Text = rarity.name, Parent = strip })
	end

	if info.color then
		local ball = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 32),
			Size = UDim2.fromOffset(62, 62),
			BackgroundColor3 = info.color,
			Parent = frame,
		}, { Ui.Round(), Ui.Outline(3), Ui.Shine() })
		if info.ring then
			ball.BackgroundTransparency = 0.7
			ball:FindFirstChildOfClass("UIStroke").Color = info.color
			ball:FindFirstChildOfClass("UIStroke").Thickness = 6
		end
		if info.rainbow then
			create("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
					ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 230, 80)),
					ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 220, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 90, 255)),
				}),
				Rotation = 45,
				Parent = ball,
			})
		end
	else
		Ui.Text({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 30),
			Size = UDim2.fromOffset(70, 64),
			Text = info.icon or "?",
			Parent = frame,
		})
	end

	Ui.Text({ Position = UDim2.fromOffset(6, 100), Size = UDim2.new(1, -12, 0, 22), Text = info.title, Parent = frame })
	Ui.Text({
		Position = UDim2.fromOffset(6, 124),
		Size = UDim2.new(1, -12, 0, 18),
		Text = info.sub or "",
		TextColor3 = C.speed,
		Parent = frame,
	})
	Ui.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.new(1, -12, 0, 36),
		BackgroundColor3 = info.buttonColor,
		Text = info.buttonText,
		Parent = frame,
	}, info.onClick)
	return frame
end

local function send(...)
	ActionRemote:FireServer(...)
end

-- 상점 ---------------------------------------------------------------------------------

local function buildShop(screen)
	local window, content, header = Ui.Window(screen, "🛒 상점", C.orange, UDim2.fromOffset(700, 480))
	Ui.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -56, 0.5, 0),
		Size = UDim2.fromOffset(160, 42),
		BackgroundColor3 = C.green,
		Text = "✅ 최강 장착",
		ZIndex = 22,
		Parent = header,
	}, function()
		send("equipBest")
	end)

	local grid = Ui.Grid(content, UDim2.fromOffset(146, 196), {
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 1, -54),
	})
	local currentTab = 1

	local function fill()
		clearGrid(grid)
		local trophies = State.Get("Trophies")
		if currentTab == 1 then
			local equipped = State.Get("Skin")
			for order, skin in ipairs(Config.Skins) do
				local owned = State.OwnsSkin(skin)
				local text, color = "", C.disabled
				if owned and equipped == skin.id then
					text, color = "장착됨", C.disabled
				elseif owned then
					text, color = "장착", C.green
				elseif skin.boss then
					text, color = "👑 월드" .. skin.boss .. " 보스", C.purple
				elseif skin.pass then
					text, color = "R$ " .. Config.GamePasses[skin.pass].robux, C.green
				else
					text, color = "🏆 " .. Format.Short(skin.cost), trophies >= skin.cost and C.gold or C.disabled
				end
				card(grid, order, {
					title = skin.name,
					sub = "속도 x" .. Format.Short(skin.mult),
					rarity = skin.rarity,
					color = skin.color,
					rainbow = skin.rainbow,
					highlight = equipped == skin.id,
					buttonText = text,
					buttonColor = color,
					onClick = function()
						send(owned and "equipSkin" or "buySkin", skin.id)
					end,
				})
			end
		elseif currentTab == 2 then
			local equipped = State.Get("Aura")
			for order, aura in ipairs(Config.Auras) do
				local owned = State.OwnsAura(aura)
				local text, color
				if owned and equipped == aura.id then
					text, color = "해제", C.disabled
				elseif owned then
					text, color = "장착", C.green
				else
					text, color = "🏆 " .. Format.Short(aura.cost), trophies >= aura.cost and C.gold or C.disabled
				end
				card(grid, order, {
					title = aura.name,
					sub = "속도 x" .. Format.Short(aura.mult),
					rarity = aura.rarity,
					color = aura.color,
					ring = true,
					highlight = equipped == aura.id,
					buttonText = text,
					buttonColor = color,
					onClick = function()
						if owned then
							send("equipAura", equipped == aura.id and "" or aura.id)
						else
							send("buyAura", aura.id)
						end
					end,
				})
			end
		else
			for order, key in ipairs(Config.PassOrder) do
				local pass = Config.GamePasses[key]
				local owned = State.OwnsPass(key)
				card(grid, order, {
					title = pass.name,
					sub = pass.desc,
					icon = pass.icon,
					highlight = owned,
					buttonText = owned and "보유 중" or ("R$ " .. pass.robux),
					buttonColor = owned and C.disabled or C.green,
					onClick = function()
						if not owned then
							send("buyPass", key)
						end
					end,
				})
			end
		end
	end

	local _, selectTab = Ui.Tabs(content, { "🎾 왁뿌볼", "✨ 오라", "💎 게임패스" }, function(index)
		currentTab = index
		fill()
	end)
	selectTab(1)

	return { frame = window, refresh = fill }
end

-- 텔레포트 ------------------------------------------------------------------------------

local function buildTeleport(screen)
	local window, content = Ui.Window(screen, "🌀 텔레포트", C.purple, UDim2.fromOffset(700, 480))
	local grid = Ui.Grid(content, UDim2.fromOffset(118, 92), {
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 1, -54),
	})
	local lockLabel = Ui.Text({
		Position = UDim2.fromOffset(0, 120),
		Size = UDim2.new(1, 0, 0, 90),
		Visible = false,
		ZIndex = 22,
		Parent = content,
	})
	local currentWorld = 1

	local function fill()
		clearGrid(grid)
		local world = Config.Worlds[currentWorld]
		local level = State.Get("Level")
		lockLabel.Visible = level < world.level
		if level < world.level then
			lockLabel.Text = "🔒 월드 " .. currentWorld .. " · " .. world.name .. "\n레벨 " .. world.level .. "부터 갈 수 있어요"
			return
		end
		local best = State.BestStage(currentWorld)
		local trophies = State.Get("Trophies")
		for stage = 1, Config.StagesPerWorld do
			local reachable = stage <= best + 1
			local cost = Config.TeleportCost(currentWorld, stage)
			local text, color
			if not reachable then
				text, color = "🔒\n스테이지 " .. stage, C.disabled
			else
				local price = cost == 0 and "무료" or ("🏆 " .. Format.Short(cost))
				text = "스테이지 " .. stage .. "\n" .. price
				color = trophies >= cost and (stage == Config.StagesPerWorld and C.red or C.blue) or C.disabled
			end
			Ui.Button({
				Name = "Stage" .. stage,
				LayoutOrder = stage,
				BackgroundColor3 = color,
				Text = text,
				Parent = grid,
			}, function()
				if reachable then
					send("teleport", currentWorld, stage)
					window.Visible = false
				end
			end)
		end
	end

	local tabNames = {}
	for index in ipairs(Config.Worlds) do
		tabNames[index] = "🌍 월드 " .. index
	end
	local _, selectTab = Ui.Tabs(content, tabNames, function(index)
		currentWorld = index
		fill()
	end)
	selectTab(1)

	return { frame = window, refresh = fill }
end

-- 코드 ---------------------------------------------------------------------------------

local function buildCodes(screen)
	local window, content = Ui.Window(screen, "🎟️ 코드", C.blue, UDim2.fromOffset(480, 280))
	local box = create("TextBox", {
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = Color3.fromRGB(245, 245, 250),
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(40, 40, 60),
		PlaceholderText = "코드를 입력하세요",
		Text = "",
		ClearTextOnFocus = false,
		ZIndex = 22,
		Parent = content,
	}, { Ui.Corner(12), Ui.Outline(3), Ui.Padding(10) })
	Ui.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(0.6, 0, 0, 60),
		BackgroundColor3 = C.green,
		Text = "사용하기",
		ZIndex = 22,
		Parent = content,
	}, function()
		if box.Text ~= "" then
			send("code", box.Text)
			box.Text = ""
		end
	end)
	return { frame = window, refresh = function() end }
end

-- 환생 ---------------------------------------------------------------------------------

local function buildRebirth(screen)
	local window, content = Ui.Window(screen, "🔁 환생", C.red, UDim2.fromOffset(520, 420))
	local info = Ui.Text({
		Size = UDim2.new(1, 0, 0, 230),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		RichText = true,
		ZIndex = 22,
		Parent = content,
	})
	local button = Ui.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(0.8, 0, 0, 70),
		BackgroundColor3 = C.red,
		Text = "🔁 환생하기",
		ZIndex = 22,
		Parent = content,
	}, function()
		send("rebirth")
	end)

	local function refresh()
		local rebirths = State.Get("Rebirths")
		local level = State.Get("Level")
		local need = Config.RebirthLevel(rebirths)
		local ready = level >= need
		info.Text = string.format(
			'환생 <font color="#FFCD3C">%d회 → %d회</font>\n속도 배수 <font color="#6EE1FF">x%s → x%s</font>\n필요 레벨 <font color="%s">Lv %d</font> (지금 Lv %d)\n\n초기화: 속도, 레벨\n유지: 트로피, 왁뿌볼, 오라, 던지기 파워',
			rebirths,
			rebirths + 1,
			Format.Short(Config.RebirthMultiplier(rebirths)),
			Format.Short(Config.RebirthMultiplier(rebirths + 1)),
			ready and "#78FF8C" or "#FF7878",
			need,
			level
		)
		button.BackgroundColor3 = ready and C.red or C.disabled
		button.Label.Text = ready and "🔁 환생하기" or ("Lv " .. need .. " 필요")
	end
	return { frame = window, refresh = refresh }
end

-- 바깥에서 쓰는 함수 --------------------------------------------------------------------

function Menus.Init(screen, actionRemote)
	ActionRemote = actionRemote
	windows.shop = buildShop(screen)
	windows.teleport = buildTeleport(screen)
	windows.codes = buildCodes(screen)
	windows.rebirth = buildRebirth(screen)
end

function Menus.Toggle(name)
	local target = windows[name]
	local opening = not target.frame.Visible
	for _, window in pairs(windows) do
		window.frame.Visible = false
	end
	if opening then
		target.refresh()
		target.frame.Visible = true
		Ui.Pop(target.frame, 0.85)
	end
end

function Menus.CloseAll()
	for _, window in pairs(windows) do
		window.frame.Visible = false
	end
end

-- 창에 보이는 값이 바뀌었을 때만 다시 그립니다 (속도는 너무 자주 바뀌어서 제외)
local WATCHED = {
	Trophies = true,
	Skin = true,
	Aura = true,
	SkinsJson = true,
	AurasJson = true,
	PassesJson = true,
	BestStagesJson = true,
	Level = true,
	Rebirths = true,
}

function Menus.OnAttributeChanged(name)
	if not WATCHED[name] then
		return
	end
	for _, window in pairs(windows) do
		if window.frame.Visible then
			window.refresh()
		end
	end
end

return Menus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--[[
	내 정보 읽기 (서버가 플레이어 속성으로 보내주는 값)
]]

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer

local State = {}

local DEFAULTS = { Pad = 1, Level = 1, Skin = "basic", Aura = "" }

function State.Get(name)
	local value = player:GetAttribute(name)
	if value == nil then
		return DEFAULTS[name] or 0
	end
	return value
end

local jsonCache = {}

-- 표 값 (Skins, Auras, BestStages, Passes)
function State.Json(name)
	local raw = player:GetAttribute(name .. "Json")
	if raw == nil then
		return {}
	end
	local cached = jsonCache[name]
	if cached and cached.raw == raw then
		return cached.value
	end
	local ok, value = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	value = ok and type(value) == "table" and value or {}
	jsonCache[name] = { raw = raw, value = value }
	return value
end

function State.OwnsPass(key)
	return key ~= nil and State.Json("Passes")[key] == true
end

function State.OwnsSkin(skin)
	return skin.id == "basic" or State.Json("Skins")[skin.id] == true or State.OwnsPass(skin.pass)
end

function State.OwnsAura(aura)
	return State.Json("Auras")[aura.id] == true
end

function State.BestStage(world)
	return tonumber(State.Json("BestStages")[world]) or 0
end

function State.EventMultiplier()
	if (workspace:GetAttribute("EventEnds") or 0) > os.time() then
		return workspace:GetAttribute("EventMult") or 1
	end
	return 1
end

function State.Context()
	return {
		pad = State.Get("Pad"),
		rebirths = State.Get("Rebirths"),
		skin = State.Get("Skin"),
		aura = State.Get("Aura"),
		doubleSpeed = State.OwnsPass("DoubleSpeed"),
		eventMult = State.EventMultiplier(),
	}
end

function State.Gain()
	return Config.GainPerThrow(State.Context())
end

function State.CanAutoThrow()
	return Config.FreeAutoThrow or State.OwnsPass("AutoThrow")
end

-- 값이 바뀔 때마다 부릅니다
function State.OnChanged(callback)
	player.AttributeChanged:Connect(callback)
	workspace:GetAttributeChangedSignal("EventMult"):Connect(callback)
	workspace:GetAttributeChangedSignal("EventEnds"):Connect(callback)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[--[[
	UI 만들기 도구 모음 (시뮬레이터 게임 스타일: 굵은 테두리, 통통한 버튼, 큰 글씨)
]]

local TweenService = game:GetService("TweenService")

local Ui = {}

Ui.Colors = {
	panel = Color3.fromRGB(32, 28, 52),
	panelLight = Color3.fromRGB(55, 48, 85),
	text = Color3.fromRGB(255, 255, 255),
	speed = Color3.fromRGB(110, 225, 255),
	gold = Color3.fromRGB(255, 205, 60),
	green = Color3.fromRGB(70, 205, 100),
	orange = Color3.fromRGB(255, 140, 50),
	red = Color3.fromRGB(235, 70, 80),
	purple = Color3.fromRGB(150, 90, 245),
	pink = Color3.fromRGB(255, 110, 180),
	blue = Color3.fromRGB(70, 150, 255),
	disabled = Color3.fromRGB(105, 105, 120),
	outline = Color3.fromRGB(20, 15, 35),
}

local C = Ui.Colors

function Ui.Create(className, props, children)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

local create = Ui.Create

function Ui.Corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Ui.Round()
	return create("UICorner", { CornerRadius = UDim.new(1, 0) })
end

function Ui.Outline(thickness, color)
	return create("UIStroke", {
		Color = color or C.outline,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Ui.Padding(pixels)
	local p = UDim.new(0, pixels)
	return create("UIPadding", { PaddingLeft = p, PaddingRight = p, PaddingTop = p, PaddingBottom = p })
end

-- 위는 밝고 아래는 어두운 버튼 그라데이션
function Ui.Shine()
	return create("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
		Rotation = 90,
	})
end

-- 글자 테두리가 있는 라벨
function Ui.Text(props)
	local strokeThickness = props.TextStroke or 2
	props.TextStroke = nil
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or Enum.Font.FredokaOne
	props.TextColor3 = props.TextColor3 or C.text
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local label = create("TextLabel", props)
	create("UIStroke", { Color = C.outline, Thickness = strokeThickness, Parent = label })
	return label
end

-- 통통한 버튼
function Ui.Button(props, onClick)
	local color = props.BackgroundColor3 or C.blue
	local button = create("TextButton", {
		Name = props.Name or "Button",
		AnchorPoint = props.AnchorPoint,
		Position = props.Position,
		Size = props.Size,
		LayoutOrder = props.LayoutOrder,
		BackgroundColor3 = color,
		Text = "",
		AutoButtonColor = true,
		Visible = props.Visible ~= false,
		ZIndex = props.ZIndex,
		Parent = props.Parent,
	}, { Ui.Corner(props.Radius or 14), Ui.Outline(3), Ui.Shine() })
	local label = Ui.Text({
		Name = "Label",
		Size = UDim2.new(1, -12, 1, -8),
		Position = UDim2.fromOffset(6, 4),
		Text = props.Text or "",
		TextColor3 = props.TextColor3,
		ZIndex = props.ZIndex,
		Parent = button,
	})
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button, label
end

-- 왼쪽/오른쪽 세로 줄에 들어가는 큰 아이콘 버튼 (아이콘 + 아래 이름)
function Ui.IconButton(props, onClick)
	local button = Ui.Button({
		Name = props.Name,
		Size = UDim2.fromOffset(78, 78),
		LayoutOrder = props.LayoutOrder,
		BackgroundColor3 = props.Color,
		Text = props.Icon,
		Parent = props.Parent,
		Radius = 18,
	}, onClick)
	button.Label.Size = UDim2.new(1, -16, 0.62, 0)
	button.Label.Position = UDim2.fromOffset(8, 4)
	local caption = Ui.Text({
		Name = "Caption",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 10),
		Size = UDim2.new(1, 14, 0, 26),
		Text = props.Caption,
		TextStroke = 3,
		Parent = button,
	})
	-- 오른쪽 위 작은 빨간 알림 배지
	local badge = Ui.Text({
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = C.red,
		Text = "!",
		Visible = false,
		ZIndex = 3,
		Parent = button,
	})
	Ui.Round().Parent = badge
	return button, caption, badge
end

function Ui.Panel(props, children)
	props.BackgroundColor3 = props.BackgroundColor3 or C.panel
	props.BackgroundTransparency = props.BackgroundTransparency or 0.1
	local frame = create("Frame", props, { Ui.Corner(16), Ui.Outline(3) })
	for _, child in ipairs(children or {}) do
		child.Parent = frame
	end
	return frame
end

-- 살짝 커졌다 돌아오는 효과
function Ui.Pop(guiObject, size)
	local scale = guiObject:FindFirstChild("PopScale") or create("UIScale", { Name = "PopScale", Parent = guiObject })
	scale.Scale = size or 1.2
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

-- 가운데 뜨는 창 (제목줄, 닫기 버튼, 내용 영역)
function Ui.Window(parent, title, color, size)
	local window = Ui.Panel({
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = size or UDim2.fromOffset(660, 450),
		BackgroundTransparency = 0,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	})
	local header = create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 60),
		BackgroundColor3 = color,
		ZIndex = 21,
		Parent = window,
	}, { Ui.Corner(16), Ui.Shine() })
	Ui.Text({
		Name = "Title",
		Position = UDim2.fromOffset(18, 8),
		Size = UDim2.new(0.6, 0, 1, -16),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextStroke = 3,
		ZIndex = 22,
		Parent = header,
	})
	local close = Ui.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 12, 0, -12),
		Size = UDim2.fromOffset(52, 52),
		BackgroundColor3 = C.red,
		Text = "X",
		ZIndex = 23,
		Parent = window,
	})
	close.Activated:Connect(function()
		window.Visible = false
	end)
	local content = create("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(14, 72),
		Size = UDim2.new(1, -28, 1, -86),
		BackgroundTransparency = 1,
		ZIndex = 21,
		Parent = window,
	})
	return window, content, header
end

-- 카드가 격자로 늘어서는 스크롤 영역
function Ui.Grid(parent, cellSize, props)
	local scroll = create("ScrollingFrame", {
		Name = "Grid",
		Position = props and props.Position or UDim2.new(),
		Size = props and props.Size or UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 21,
		Parent = parent,
	})
	create("UIGridLayout", {
		CellSize = cellSize,
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = scroll,
	})
	create("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = scroll })
	return scroll
end

-- 창 안의 탭 버튼 줄
function Ui.Tabs(parent, names, onSelect)
	local bar = create("Frame", {
		Name = "Tabs",
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		ZIndex = 21,
		Parent = parent,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = bar,
	})
	local buttons = {}
	local function selectIndex(index)
		for i, button in ipairs(buttons) do
			button.BackgroundColor3 = i == index and C.gold or C.panelLight
		end
		onSelect(index)
	end
	for index, name in ipairs(names) do
		buttons[index] = Ui.Button({
			Name = "Tab" .. index,
			Size = UDim2.fromOffset(150, 44),
			LayoutOrder = index,
			BackgroundColor3 = C.panelLight,
			Text = name,
			ZIndex = 22,
			Parent = bar,
		}, function()
			selectIndex(index)
		end)
	end
	return bar, selectIndex
end

return Ui
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="18">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>